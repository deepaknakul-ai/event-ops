// --- Amount extraction: finds numbers anywhere in the text ---
function extractAmount(text) {
  // Remove currency symbols/words for cleaner matching
  const cleaned = text
    .replace(/\b(rs\.?|rupees?|inr|amount)\b/gi, '')
    .replace(/[₹$]/g, '');

  // Match Indian-style numbers: 1,50,000 or 150000 or 1.5L or 50k etc.
  const patterns = [
    /(\d[\d,]*(?:\.\d+)?)\s*(?:lakh|lac|l)\b/i,      // 1.5 lakh / 2L
    /(\d[\d,]*(?:\.\d+)?)\s*(?:crore|cr)\b/i,         // 1 crore / 2cr
    /(\d[\d,]*(?:\.\d+)?)\s*k\b/i,                    // 50k
    /(\d[\d,]*\.\d+)/,                                  // 1,50,000.50
    /(\d[\d,]+)/,                                       // 150000 or 1,50,000
  ];

  for (const pat of patterns) {
    const m = cleaned.match(pat);
    if (m) {
      let num = parseFloat(m[1].replace(/,/g, ''));
      const suffix = cleaned.slice(m.index + m[0].length).trim().toLowerCase();
      const matchedSuffix = m[0].toLowerCase();
      if (matchedSuffix.includes('lakh') || matchedSuffix.includes('lac') || matchedSuffix.endsWith('l')) num *= 100000;
      else if (matchedSuffix.includes('crore') || matchedSuffix.includes('cr')) num *= 10000000;
      else if (matchedSuffix.endsWith('k')) num *= 1000;
      if (num > 0) return num;
    }
  }
  return 0;
}

// --- Fuzzy party resolution: matches user text to known parties ---
function resolveParty(raw, ctx) {
  if (!raw) return '';
  const cleaned = raw.trim().replace(/[.!?,;:]+$/, '');
  if (!ctx?.partyNames?.length) return cleaned;

  const lower = cleaned.toLowerCase();

  // 1. Exact match
  const exact = ctx.partyNames.find(p => p.toLowerCase() === lower);
  if (exact) return exact;

  // 2. Starts-with match (user typed partial)
  const startsWith = ctx.partyNames.find(p => p.toLowerCase().startsWith(lower));
  if (startsWith) return startsWith;

  // 3. Contains match
  const contains = ctx.partyNames.find(p =>
    p.toLowerCase().includes(lower) || lower.includes(p.toLowerCase())
  );
  if (contains) return contains;

  // 4. Token overlap: "acme" matches "Acme Corp Pvt Ltd"
  const inputTokens = lower.split(/\s+/);
  let bestMatch = null;
  let bestScore = 0;
  for (const name of ctx.partyNames) {
    const nameTokens = name.toLowerCase().split(/\s+/);
    let score = 0;
    for (const it of inputTokens) {
      if (it.length < 2) continue;
      for (const nt of nameTokens) {
        if (nt === it) score += 3;
        else if (nt.startsWith(it) || it.startsWith(nt)) score += 2;
        else if (nt.includes(it) || it.includes(nt)) score += 1;
      }
    }
    if (score > bestScore) { bestScore = score; bestMatch = name; }
  }
  if (bestScore >= 2) return bestMatch;

  return cleaned;
}

// --- Extract party name from text after removing known tokens ---
function extractParty(text, ctx) {
  // First try to find a known party name in the text via fuzzy match
  if (ctx?.partyNames?.length) {
    const lower = text.toLowerCase();
    // Direct substring match against known names (longest first)
    const sorted = [...ctx.partyNames].sort((a, b) => b.length - a.length);
    for (const name of sorted) {
      if (lower.includes(name.toLowerCase())) return name;
    }
    // Token overlap search
    const words = lower.split(/\s+/);
    for (const name of sorted) {
      const nameTokens = name.toLowerCase().split(/\s+/);
      const matchCount = nameTokens.filter(nt =>
        words.some(w => w === nt || (w.length >= 3 && (w.startsWith(nt) || nt.startsWith(w))))
      ).length;
      if (matchCount > 0 && matchCount >= nameTokens.length * 0.5) return name;
    }
  }

  // Fallback: extract text after directional prepositions
  const dirMatch = text.match(/(?:from|to|for|by|of|with|client|vendor|party|company)\s+(.+)/i);
  if (dirMatch) {
    const candidate = dirMatch[1]
      .replace(/\b(rs\.?|rupees?|inr|amount|of|the|a|an)\b/gi, '')
      .replace(/[\d,₹$]+[kKlLcC]?\b/g, '')
      .replace(/\s{2,}/g, ' ')
      .trim()
      .replace(/[.!?,;:]+$/, '');
    if (candidate.length >= 2) return resolveParty(candidate, ctx);
  }

  // Last resort: take the longest non-numeric, non-keyword segment
  const stripped = text
    .replace(/\b(received|got|collected|recd|paid|pay|sent|gave|transferred|invoice|invoiced|billed|bill|salary|wages|expense|spent|advance|purchased|bought|deposit|deposited|withdraw|withdrew|tds|credit\s*note|debit\s*note|cn|dn|rent|from|to|for|by|of|rs\.?|rupees?|inr|amount|via|bank|neft|rtgs|upi|imps|cash|cheque|check|online|the|a|an|is|was|has|have|been|with|on|in|into|towards|against)\b/gi, '')
    .replace(/[\d,₹$]+[kKlLcC]?\b/g, '')
    .replace(/[.!?,;:()[\]{}]+/g, '')
    .replace(/\s{2,}/g, ' ')
    .trim();
  if (stripped.length >= 2) return resolveParty(stripped, ctx);

  return '';
}

// --- Intent classification from keywords (order-independent) ---
const INTENT_SIGNALS = {
  receipt: {
    keywords: ['received', 'receive', 'got', 'collected', 'collection', 'recd', 'incoming', 'came in', 'money came', 'payment from', 'amount from', 'client paid', 'customer paid', 'they paid'],
    weight: 10,
  },
  payment: {
    keywords: ['paid', 'pay', 'sent', 'transferred', 'transfer', 'gave', 'given', 'outgoing', 'payment to', 'amount to', 'settled', 'cleared'],
    weight: 10,
  },
  invoice: {
    keywords: ['invoice', 'invoiced', 'billed', 'bill', 'raised invoice', 'raise invoice', 'billing', 'raise bill'],
    weight: 15,
  },
  salary: {
    keywords: ['salary', 'salaries', 'wages', 'wage', 'payroll', 'staff payment', 'employee payment', 'stipend'],
    weight: 15,
  },
  expense: {
    keywords: ['expense', 'spent', 'spending', 'expensed', 'cost', 'charged', 'office expense', 'misc expense'],
    weight: 12,
  },
  advance: {
    keywords: ['advance', 'adv', 'advance to', 'loan to employee', 'staff advance', 'employee advance'],
    weight: 15,
  },
  purchase: {
    keywords: ['purchased', 'bought', 'purchase', 'buying', 'procurement', 'ordered', 'vendor bill', 'supplier'],
    weight: 12,
  },
  bank_deposit: {
    keywords: ['deposit', 'deposited', 'cash to bank', 'bank deposit', 'put in bank', 'banked'],
    weight: 15,
  },
  bank_withdrawal: {
    keywords: ['withdraw', 'withdrew', 'withdrawal', 'cash from bank', 'bank withdrawal', 'atm'],
    weight: 15,
  },
  tds: {
    keywords: ['tds', 'tax deducted', 'tax deduction', 'withholding tax', 'tds deducted', 'tds receivable'],
    weight: 20,
  },
  credit_note: {
    keywords: ['credit note', 'credit memo', 'cn ', 'sales return', 'refund to client', 'discount given'],
    weight: 20,
  },
  debit_note: {
    keywords: ['debit note', 'debit memo', 'dn ', 'purchase return', 'returned to vendor'],
    weight: 20,
  },
  rent: {
    keywords: ['rent', 'rental', 'lease payment', 'office rent', 'shop rent'],
    weight: 15,
  },
};

function classifyIntent(text) {
  const lower = text.toLowerCase();
  const scores = {};

  for (const [intent, config] of Object.entries(INTENT_SIGNALS)) {
    scores[intent] = 0;
    for (const kw of config.keywords) {
      if (lower.includes(kw)) {
        scores[intent] += config.weight;
        // Bonus for early position (user usually leads with intent)
        const pos = lower.indexOf(kw);
        if (pos < 20) scores[intent] += 5;
      }
    }
  }

  // Contextual disambiguation
  const hasFrom = /\bfrom\b/i.test(text);
  const hasTo = /\bto\b/i.test(text);

  // "paid X from Y" is still a payment, not a receipt
  // "got X to bank" could be deposit
  if (scores.receipt > 0 && scores.payment > 0) {
    if (hasFrom && !hasTo) scores.receipt += 5;
    if (hasTo && !hasFrom) scores.payment += 5;
  }

  // If both expense and payment scored, prefer based on context
  if (scores.expense > 0 && scores.payment > 0) {
    // If there's a known party/vendor, lean toward payment
    if (hasTo) scores.payment += 3;
  }

  // Bank signals modify receipt/payment into deposit/withdrawal
  const bankSignal = /\b(bank|neft|rtgs|upi|imps|online|net banking|cheque|check)\b/i.test(text);

  // Find the winning intent
  let best = null;
  let bestScore = 0;
  for (const [intent, score] of Object.entries(scores)) {
    if (score > bestScore) { bestScore = score; best = intent; }
  }

  return { intent: best, score: bestScore, bankSignal };
}

// --- Detect payment mode from context ---
function detectPaymentMode(text) {
  const lower = text.toLowerCase();
  if (/\b(bank|neft|rtgs|imps|online|net banking|upi|gpay|phonepe|paytm)\b/.test(lower)) return 'Bank';
  if (/\b(cheque|check|chq)\b/.test(lower)) return 'Bank';
  if (/\b(cash|by hand|hand cash)\b/.test(lower)) return 'Cash';
  return 'Cash'; // default
}

// --- Guess expense account from description keywords ---
function guessExpenseAccount(desc) {
  const d = desc.toLowerCase();
  if (d.includes('rent') || d.includes('lease')) return 'Rent Expense';
  if (d.includes('travel') || d.includes('cab') || d.includes('fuel') || d.includes('petrol') || d.includes('diesel') || d.includes('uber') || d.includes('ola') || d.includes('flight') || d.includes('train') || d.includes('bus')) return 'Travel Expense';
  if (d.includes('food') || d.includes('meal') || d.includes('lunch') || d.includes('dinner') || d.includes('breakfast') || d.includes('tea') || d.includes('coffee') || d.includes('snack') || d.includes('catering')) return 'Food Expense';
  if (d.includes('salary') || d.includes('wages') || d.includes('payroll')) return 'Salary Expense';
  if (d.includes('electric') || d.includes('utility') || d.includes('water') || d.includes('internet') || d.includes('wifi') || d.includes('broadband') || d.includes('phone') || d.includes('mobile') || d.includes('recharge')) return 'Utilities Expense';
  if (d.includes('office') || d.includes('stationery') || d.includes('supplies') || d.includes('printer') || d.includes('paper') || d.includes('pen')) return 'Office Supplies Expense';
  if (d.includes('repair') || d.includes('maintenance') || d.includes('service') || d.includes('amc') || d.includes('fix')) return 'Repairs & Maintenance';
  if (d.includes('insurance') || d.includes('premium')) return 'Insurance Expense';
  if (d.includes('legal') || d.includes('lawyer') || d.includes('advocate') || d.includes('court')) return 'Legal Expense';
  if (d.includes('marketing') || d.includes('adverti') || d.includes('promo') || d.includes('campaign') || d.includes('ads')) return 'Marketing Expense';
  if (d.includes('commission') || d.includes('brokerage')) return 'Commission Expense';
  if (d.includes('courier') || d.includes('shipping') || d.includes('freight') || d.includes('transport') || d.includes('logistics')) return 'Freight & Logistics';
  return 'Expense:General';
}

// ═══════════════════════════════════════════════════════════════════
// MAIN PARSER: Combines intent + amount + party extraction
// ═══════════════════════════════════════════════════════════════════
function parseUserMessage(text, ctx) {
  const trimmed = text.trim();
  if (!trimmed || trimmed.length < 3) return null;

  // Step 1: Extract amount
  const amount = extractAmount(trimmed);
  if (amount <= 0) return null; // Must have a number to create an entry

  // Step 2: Classify intent
  const { intent, score, bankSignal } = classifyIntent(trimmed);
  if (!intent || score <= 0) return null;

  // Step 3: Extract party name
  const party = extractParty(trimmed, ctx);
  const mode = detectPaymentMode(trimmed);
  const debitTo = mode === 'Bank' ? 'Bank' : 'Cash';

  // Step 4: Build entry based on intent
  switch (intent) {
    case 'receipt': {
      const p = party || 'Unknown Client';
      return {
        type: 'receipt',
        entries: [{ debitAccount: bankSignal ? 'Bank' : debitTo, creditAccount: `Party: ${p}`, amount }],
        narration: `Payment received from ${p}${bankSignal ? ' (bank)' : ''}`,
        meta: { party: p, amount },
      };
    }
    case 'payment': {
      const p = party || 'Unknown Vendor';
      return {
        type: 'payment',
        entries: [{ debitAccount: `Party: ${p}`, creditAccount: bankSignal ? 'Bank' : debitTo, amount }],
        narration: `Payment made to ${p}${bankSignal ? ' (bank)' : ''}`,
        meta: { party: p, amount },
      };
    }
    case 'invoice': {
      const p = party || 'Unknown Client';
      const gst = Math.round(amount * 18 / 118 * 100) / 100;
      const taxable = amount - gst;
      return {
        type: 'invoice',
        entries: [
          { debitAccount: `Party: ${p}`, creditAccount: 'Sales Revenue', amount: taxable },
          { debitAccount: `Party: ${p}`, creditAccount: 'Output GST Payable', amount: gst },
        ],
        narration: `Invoice raised to ${p} (incl. 18% GST)`,
        meta: { party: p, amount, taxable, gst },
      };
    }
    case 'salary': {
      const name = party || 'Staff';
      return {
        type: 'salary',
        entries: [{ debitAccount: 'Salary Expense', creditAccount: bankSignal ? 'Bank' : 'Cash', amount }],
        narration: `Salary paid to ${name}`,
        meta: { name, amount },
      };
    }
    case 'expense': {
      const desc = party || trimmed;
      return {
        type: 'expense',
        entries: [{ debitAccount: guessExpenseAccount(trimmed), creditAccount: bankSignal ? 'Bank' : 'Cash', amount }],
        narration: `Expense: ${desc}`,
        meta: { desc, amount },
      };
    }
    case 'advance': {
      const name = party || 'Employee';
      return {
        type: 'advance',
        entries: [{ debitAccount: 'Employee Advances', creditAccount: bankSignal ? 'Bank' : 'Cash', amount }],
        narration: `Advance given to ${name}`,
        meta: { name, amount },
      };
    }
    case 'purchase': {
      const p = party || 'Unknown Vendor';
      const gst = Math.round(amount * 18 / 118 * 100) / 100;
      const taxable = amount - gst;
      return {
        type: 'purchase',
        entries: [
          { debitAccount: 'Purchase Expense', creditAccount: `Party: ${p}`, amount: taxable },
          { debitAccount: 'Input GST Credit', creditAccount: `Party: ${p}`, amount: gst },
        ],
        narration: `Purchase from ${p} (incl. 18% GST)`,
        meta: { party: p, amount, taxable, gst },
      };
    }
    case 'bank_deposit': {
      return {
        type: 'bank_deposit',
        entries: [{ debitAccount: 'Bank', creditAccount: 'Cash', amount }],
        narration: 'Cash deposited to bank',
        meta: { amount },
      };
    }
    case 'bank_withdrawal': {
      return {
        type: 'bank_withdrawal',
        entries: [{ debitAccount: 'Cash', creditAccount: 'Bank', amount }],
        narration: 'Cash withdrawn from bank',
        meta: { amount },
      };
    }
    case 'tds': {
      const p = party || 'Unknown Party';
      return {
        type: 'tds',
        entries: [{ debitAccount: 'TDS Receivable', creditAccount: `Party: ${p}`, amount }],
        narration: `TDS deducted by ${p}`,
        meta: { party: p, amount },
      };
    }
    case 'credit_note': {
      const p = party || 'Unknown Client';
      return {
        type: 'credit_note',
        entries: [{ debitAccount: 'Sales Revenue', creditAccount: `Party: ${p}`, amount }],
        narration: `Credit Note issued to ${p}`,
        meta: { party: p, amount },
      };
    }
    case 'debit_note': {
      const p = party || 'Unknown Vendor';
      return {
        type: 'debit_note',
        entries: [{ debitAccount: `Party: ${p}`, creditAccount: 'Purchase Expense', amount }],
        narration: `Debit Note issued to ${p}`,
        meta: { party: p, amount },
      };
    }
    case 'rent': {
      return {
        type: 'expense',
        entries: [{ debitAccount: 'Rent Expense', creditAccount: bankSignal ? 'Bank' : 'Cash', amount }],
        narration: `Rent payment${party ? ` to ${party}` : ''}`,
        meta: { amount },
      };
    }
    default:
      return null;
  }
}


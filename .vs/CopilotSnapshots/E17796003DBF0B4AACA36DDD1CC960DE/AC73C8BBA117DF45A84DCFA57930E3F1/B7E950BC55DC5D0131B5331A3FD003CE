import React, { useState, useRef, useEffect, useMemo, useCallback } from 'react';
import { X, Sparkles, Send, Check, Edit3, RotateCcw } from 'lucide-react';
import { formatCurrency } from '../utils/helpers';

// NLP Pattern Matchers
const PATTERNS = [
  {
    id: 'receive_bank',
    regex: /(?:received|got|collected|recd)\s+(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s+(?:in\s+bank|via\s+bank|bank\s+transfer|neft|rtgs|upi|imps)\s+(?:from|fr)\s+(.+)/i,
    build: (m, ctx) => {
      const amount = parseNumber(m[1]);
      const party = resolveParty(m[2].trim().replace(/[.!]+$/, ''), ctx);
      return { type: 'receipt', entries: [{ debitAccount: 'Bank', creditAccount: `Party: ${party}`, amount }], narration: `Bank payment received from ${party}`, meta: { party, amount } };
    },
  },
  {
    id: 'receive_payment',
    regex: /(?:received|got|collected|recd)\s+(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s+(?:from|fr)\s+(.+)/i,
    build: (m, ctx) => {
      const amount = parseNumber(m[1]);
      const party = resolveParty(m[2].trim().replace(/[.!]+$/, ''), ctx);
      return { type: 'receipt', entries: [{ debitAccount: 'Cash', creditAccount: `Party: ${party}`, amount }], narration: `Payment received from ${party}`, meta: { party, amount } };
    },
  },
  {
    id: 'make_payment',
    regex: /(?:paid|pay|sent|transferred|gave)\s+(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s+(?:to)\s+(.+)/i,
    build: (m, ctx) => {
      const amount = parseNumber(m[1]);
      const party = resolveParty(m[2].trim().replace(/[.!]+$/, ''), ctx);
      return { type: 'payment', entries: [{ debitAccount: `Party: ${party}`, creditAccount: 'Cash', amount }], narration: `Payment made to ${party}`, meta: { party, amount } };
    },
  },
  {
    id: 'raise_invoice',
    regex: /(?:invoice|invoiced|billed|bill|raised?\s+invoice)\s+(?:of\s+)?(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s+(?:to|for)\s+(.+)/i,
    build: (m, ctx) => {
      const amount = parseNumber(m[1]);
      const party = resolveParty(m[2].trim().replace(/[.!]+$/, ''), ctx);
      const gst = Math.round(amount * 18 / 118 * 100) / 100;
      const taxable = amount - gst;
      return { type: 'invoice', entries: [{ debitAccount: `Party: ${party}`, creditAccount: 'Sales Revenue', amount: taxable }, { debitAccount: `Party: ${party}`, creditAccount: 'Output GST Payable', amount: gst }], narration: `Invoice raised to ${party} (incl. 18% GST)`, meta: { party, amount, taxable, gst } };
    },
  },
  {
    id: 'salary',
    regex: /(?:salary|salaries|wages?)\s+(?:of\s+)?(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s+(?:to|for)\s+(.+)/i,
    build: (m) => {
      const amount = parseNumber(m[1]);
      const name = m[2].trim().replace(/[.!]+$/, '');
      return { type: 'salary', entries: [{ debitAccount: 'Salary Expense', creditAccount: 'Cash', amount }], narration: `Salary paid to ${name}`, meta: { name, amount } };
    },
  },
  {
    id: 'expense',
    regex: /(?:expense|spent|expensed)\s+(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s+(?:for|on|towards)\s+(.+)/i,
    build: (m) => {
      const amount = parseNumber(m[1]);
      const desc = m[2].trim().replace(/[.!]+$/, '');
      return { type: 'expense', entries: [{ debitAccount: guessExpenseAccount(desc), creditAccount: 'Cash', amount }], narration: `Expense: ${desc}`, meta: { desc, amount } };
    },
  },
  {
    id: 'advance',
    regex: /(?:advance|adv)\s+(?:of\s+)?(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s+(?:to)\s+(.+)/i,
    build: (m) => {
      const amount = parseNumber(m[1]);
      const name = m[2].trim().replace(/[.!]+$/, '');
      return { type: 'advance', entries: [{ debitAccount: 'Employee Advances', creditAccount: 'Cash', amount }], narration: `Advance given to ${name}`, meta: { name, amount } };
    },
  },
  {
    id: 'purchase',
    regex: /(?:purchased|bought|purchase)\s+(?:.*?\s+)?(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s+(?:from)\s+(.+)/i,
    build: (m, ctx) => {
      const amount = parseNumber(m[1]);
      const party = resolveParty(m[2].trim().replace(/[.!]+$/, ''), ctx);
      const gst = Math.round(amount * 18 / 118 * 100) / 100;
      const taxable = amount - gst;
      return { type: 'purchase', entries: [{ debitAccount: 'Purchase Expense', creditAccount: `Party: ${party}`, amount: taxable }, { debitAccount: 'Input GST Credit', creditAccount: `Party: ${party}`, amount: gst }], narration: `Purchase from ${party} (incl. 18% GST)`, meta: { party, amount, taxable, gst } };
    },
  },
  {
    id: 'bank_deposit',
    regex: /(?:deposit|deposited)\s+(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s*(?:to|in|into)?\s*(?:bank)?/i,
    build: (m) => {
      const amount = parseNumber(m[1]);
      return { type: 'bank_deposit', entries: [{ debitAccount: 'Bank', creditAccount: 'Cash', amount }], narration: 'Cash deposited to bank', meta: { amount } };
    },
  },
  {
    id: 'bank_withdrawal',
    regex: /(?:withdraw|withdrew|withdrawal)\s+(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s*(?:from)?\s*(?:bank)?/i,
    build: (m) => {
      const amount = parseNumber(m[1]);
      return { type: 'bank_withdrawal', entries: [{ debitAccount: 'Cash', creditAccount: 'Bank', amount }], narration: 'Cash withdrawn from bank', meta: { amount } };
    },
  },
  {
    id: 'tds_receivable',
    regex: /(?:tds)\s+(?:of\s+)?(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s+(?:deducted\s+by|from|receivable\s+from)\s+(.+)/i,
    build: (m, ctx) => {
      const amount = parseNumber(m[1]);
      const party = resolveParty(m[2].trim().replace(/[.!]+$/, ''), ctx);
      return { type: 'tds', entries: [{ debitAccount: 'TDS Receivable', creditAccount: `Party: ${party}`, amount }], narration: `TDS deducted by ${party}`, meta: { party, amount } };
    },
  },
  {
    id: 'credit_note',
    regex: /(?:credit\s*note|cn)\s+(?:of\s+)?(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s+(?:to|for)\s+(.+)/i,
    build: (m, ctx) => {
      const amount = parseNumber(m[1]);
      const party = resolveParty(m[2].trim().replace(/[.!]+$/, ''), ctx);
      return { type: 'credit_note', entries: [{ debitAccount: 'Sales Revenue', creditAccount: `Party: ${party}`, amount }], narration: `Credit Note issued to ${party}`, meta: { party, amount } };
    },
  },
  {
    id: 'debit_note',
    regex: /(?:debit\s*note|dn)\s+(?:of\s+)?(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)\s+(?:to|for)\s+(.+)/i,
    build: (m, ctx) => {
      const amount = parseNumber(m[1]);
      const party = resolveParty(m[2].trim().replace(/[.!]+$/, ''), ctx);
      return { type: 'debit_note', entries: [{ debitAccount: `Party: ${party}`, creditAccount: 'Purchase Expense', amount }], narration: `Debit Note issued to ${party}`, meta: { party, amount } };
    },
  },
  {
    id: 'rent',
    regex: /(?:rent|paid\s+rent)\s+(?:of\s+)?(?:rs\.?|inr)?\s*([\d,]+(?:\.\d+)?)/i,
    build: (m) => {
      const amount = parseNumber(m[1]);
      return { type: 'expense', entries: [{ debitAccount: 'Rent Expense', creditAccount: 'Cash', amount }], narration: 'Rent payment', meta: { amount } };
    },
  },
];

function parseNumber(str) {
  return parseFloat(str.replace(/,/g, '')) || 0;
}

function resolveParty(raw, ctx) {
  if (!ctx?.partyNames?.length) return raw;
  const lower = raw.toLowerCase();
  const exact = ctx.partyNames.find(p => p.toLowerCase() === lower);
  if (exact) return exact;
  const partial = ctx.partyNames.find(p => p.toLowerCase().includes(lower) || lower.includes(p.toLowerCase()));
  if (partial) return partial;
  return raw;
}

function guessExpenseAccount(desc) {
  const d = desc.toLowerCase();
  if (d.includes('rent')) return 'Rent Expense';
  if (d.includes('travel') || d.includes('cab') || d.includes('fuel') || d.includes('petrol')) return 'Travel Expense';
  if (d.includes('food') || d.includes('meal') || d.includes('lunch') || d.includes('dinner')) return 'Food Expense';
  if (d.includes('salary') || d.includes('wages')) return 'Salary Expense';
  if (d.includes('electric') || d.includes('utility') || d.includes('water') || d.includes('internet')) return 'Utilities Expense';
  if (d.includes('office') || d.includes('stationery') || d.includes('supplies')) return 'Office Supplies Expense';
  if (d.includes('repair') || d.includes('maintenance')) return 'Repairs & Maintenance';
  return 'Expense:General';
}

function parseUserMessage(text, ctx) {
  const trimmed = text.trim();
  if (!trimmed) return null;
  for (const pattern of PATTERNS) {
    const match = trimmed.match(pattern.regex);
    if (match) {
      try { return pattern.build(match, ctx); } catch { continue; }
    }
  }
  return null;
}


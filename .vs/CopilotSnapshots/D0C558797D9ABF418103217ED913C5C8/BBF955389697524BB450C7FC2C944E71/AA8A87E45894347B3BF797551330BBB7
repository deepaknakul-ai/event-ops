                    <p className="text-lg font-bold text-purple-900">
                      Assets = Liabilities + Equity
                    </p>
                  </div>
                  <p className="mt-3 text-sm text-purple-800">
                    This fundamental equation must always balance in your books
                  </p>
                </div>
              </div>
            </div>
          )}
        </div>

        {/* Footer */}
        <div className="border-t border-slate-200 bg-slate-50 px-6 py-4">
          <div className="flex items-center justify-between">
            <p className="text-xs text-slate-500">
              💡 Tip: Use templates to speed up common transactions
            </p>
            <button
              onClick={onClose}
              className="rounded-lg bg-slate-600 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 transition"
            >
              Close
            </button>
          </div>
        </div>
      </div>
    </div>
  );
};

export default VirtualAccountant;

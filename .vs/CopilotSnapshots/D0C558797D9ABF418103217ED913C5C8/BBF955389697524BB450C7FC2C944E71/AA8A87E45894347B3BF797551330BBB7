            <div className="flex h-10 w-10 items-center justify-center rounded-full bg-white/20">
              <Sparkles className="text-white" size={20} />
            </div>
            <div>
              <h2 className="text-xl font-bold text-white">Virtual Accountant</h2>
              <p className="text-xs text-indigo-100">AI-powered accounting assistant</p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="rounded-full p-2 text-white/80 hover:bg-white/20 transition"

const VirtualAccountant = ({ 
  isOpen, 
  onClose, 
  onApplyTemplate,
  currentEntry = {},
}) => {
  const [activeTab, setActiveTab] = useState('templates');
  const [searchTerm, setSearchTerm] = useState('');
  const [selectedTemplate, setSelectedTemplate] = useState(null);
  const validationMode = true;

  const filteredTemplates = useMemo(() => {
    if (!searchTerm) return TRANSACTION_TEMPLATES;
    const search = searchTerm.toLowerCase();
    return TRANSACTION_TEMPLATES.filter(t => 
      t.name.toLowerCase().includes(search) ||
      t.description.toLowerCase().includes(search) ||
      t.category.toLowerCase().includes(search) ||
      t.tags.some(tag => tag.includes(search))
    );
  }, [searchTerm]);

  const templatesByCategory = useMemo(() => {
    const grouped = {};
    filteredTemplates.forEach(template => {
      if (!grouped[template.category]) grouped[template.category] = [];
      grouped[template.category].push(template);
    });
    return grouped;
  }, [filteredTemplates]);

  const validation = useMemo(() => {
    if (!validationMode || !currentEntry) return { issues: [], warnings: [], suggestions: [] };
    return validateEntry(
      currentEntry.debitAccount,
      currentEntry.creditAccount,
      currentEntry.amount,
      currentEntry.narration
    );
  }, [currentEntry, validationMode]);

  const handleApplyTemplate = (template) => {
    onApplyTemplate?.({
      debitAccount: template.debit,
      creditAccount: template.credit,
      narration: template.example,
    });
    onClose();
  };


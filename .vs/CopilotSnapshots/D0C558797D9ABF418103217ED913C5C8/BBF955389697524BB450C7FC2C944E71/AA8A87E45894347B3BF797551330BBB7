// Smart validation rules
const validateEntry = (debit, credit, amount, narration) => {
  const issues = [];
  const warnings = [];
  const suggestions = [];

  // Basic validations
  if (!debit || !credit) {
    issues.push({ type: 'error', message: 'Both debit and credit accounts must be selected' });
  }

  if (debit === credit) {
    issues.push({ type: 'error', message: 'Debit and credit accounts cannot be the same' });
  }

  if (!amount || parseFloat(amount) <= 0) {
    issues.push({ type: 'error', message: 'Amount must be greater than zero' });
  }

  // Amount validations
  const amt = parseFloat(amount || 0);
  if (amt > 10000000) {
    warnings.push({ type: 'warning', message: 'Large amount detected (>1 Crore). Please verify.' });
  }

  if (amt % 1 !== 0 && amt < 10) {
    warnings.push({ type: 'warning', message: 'Small decimal amount detected. Verify precision.' });
  }

  // Narration checks
  if (!narration || narration.trim().length < 5) {
    warnings.push({ type: 'warning', message: 'Add detailed narration for better record keeping' });
  }

  // Smart suggestions based on account combinations
  const debitLower = (debit || '').toLowerCase();
  const creditLower = (credit || '').toLowerCase();

  if (debitLower.includes('expense') && creditLower.includes('revenue')) {
    issues.push({ type: 'error', message: 'Invalid: Expense cannot be debited with Revenue credited' });
  }

  if (debitLower.includes('revenue') && creditLower.includes('expense')) {
    issues.push({ type: 'error', message: 'Invalid: Revenue cannot be debited with Expense credited' });
  }

  if ((debitLower.includes('cash') || debitLower.includes('bank')) && 
      (creditLower.includes('revenue') || creditLower.includes('sales'))) {
    suggestions.push({ type: 'tip', message: 'Cash sale detected. Consider GST implications.' });
  }

  if (debitLower.includes('receivable') && creditLower.includes('revenue')) {
    suggestions.push({ type: 'tip', message: 'Credit sale. Ensure invoice is raised.' });
  }

  if (debitLower.includes('payable') && creditLower.includes('cash')) {
    suggestions.push({ type: 'tip', message: 'Vendor payment. Update purchase invoice status.' });
  }

  return { issues, warnings, suggestions };
};


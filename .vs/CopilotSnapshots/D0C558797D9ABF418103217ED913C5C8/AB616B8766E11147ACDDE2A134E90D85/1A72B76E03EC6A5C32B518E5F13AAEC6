// 2. Check snapshot
console.log('\n📈 ACCOUNTING SNAPSHOT:');
if (typeof snapshot !== 'undefined') {
  console.log('✅ Snapshot exists');
  console.log('Journal entries:', snapshot.journal?.length || 0);

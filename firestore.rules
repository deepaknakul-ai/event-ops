rules_version = '2';

// Rental-Ops Firestore rules (Phase 6 — Security Hardening).
// Deploy with:  firebase deploy --only firestore:rules
//
// Security model:
//   - All app data lives under /artifacts/{appId}/public/data/{collection}/{doc}
//   - Reads are open to any authenticated session (anonymous sessions are used
//     by the login page to read employees/settings before credentials are
//     verified — a known design constraint).
//   - Writes ALWAYS require a recognised role (admin/accountant/manager/tech/user).
//     Anonymous sessions cannot write anything.
//   - Finance-sensitive collections additionally require admin or manager.
//   - Append-only collections (audit_logs, inventory_movements) are explicitly
//     excluded from the broad wildcard update path so the specific "if false"
//     guards below cannot be bypassed via OR semantics.
//   - The /users/{uid} role mirror is constrained: self-writes may not set the
//     role field to any value other than what the canonical /employees/{uid}
//     doc already holds, closing the privilege-escalation path.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    function userEmpId() {
      return request.auth.uid;
    }

    // Token↔tenant binding: a verifyLogin/support token carries an `appId`
    // claim; a role only counts for THAT tenant. Prevents a uid that holds
    // role docs under two appIds (possible on the SaaS project) from using a
    // token minted for tenant A to act on tenant B. Tokens with no appId claim
    // (none minted by this app today) pass — preserving legacy behavior; on
    // private every token carries appId 'TERMS 1.0.0', so this is a no-op.
    function tokenApp(appId) {
      return !('appId' in request.auth.token) || request.auth.token.appId == appId;
    }

    // ── SaaS platform staff (top-level platform_* tree) ──────────────────────
    // A platform staff token carries claim `staff:true` + `staff_role`. On the
    // PRIVATE/standby projects no token has this claim and the platform_*
    // collections don't exist, so isStaff() short-circuits false and staffData()
    // is never reached — these helpers are fully inert off the SaaS project.
    function isStaff() {
      return isAuthed() && request.auth.token.get('staff', false) == true;
    }
    function staffRole() {
      return request.auth.token.get('staff_role', '');
    }
    function staffData() {
      return get(/databases/$(database)/documents/platform_staff/$(request.auth.uid)).data;
    }

    // Role lookup: /users/{uid} mirror first (written on login upgrade),
    // falls back to /employees/{uid} for the migration window.
    function userRole(appId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(userEmpId()))
        ? get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(userEmpId())).data.role
        : get(/databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(userEmpId())).data.role;
    }

    function hasRole(appId, role) {
      return isAuthed() && tokenApp(appId) && userRole(appId) == role;
    }

    function hasAnyRole(appId, roles) {
      return isAuthed() && tokenApp(appId) && (userRole(appId) in roles);
    }

    // isRoleUser: authenticated AND holds any recognised role.
    // Prevents anonymous sessions from writing (closes the broad isAuthed() gap).
    function isRoleUser(appId) {
      return hasAnyRole(appId, ['admin', 'accountant', 'manager', 'tech', 'user', 'partner']);
    }

    // Finance writers: Owner + Accountant (the finance operators) + Manager (needed
    // for the scoped own-client receipt form). Accountant was previously missing,
    // which silently blocked every accountant finance/accounting write.
    function isFinanceWriter(appId) {
      return hasAnyRole(appId, ['admin', 'accountant', 'manager']);
    }

    function isAdmin(appId) {
      return hasRole(appId, 'admin');
    }

    // Admin + Accountant get full (unscoped) visibility of clients/projects.
    function isAccountant(appId) {
      return hasRole(appId, 'accountant');
    }
    function seesAllParties(appId) {
      return isAdmin(appId) || isAccountant(appId);
    }

    // ── Partnership (s.12(d) Partnership Act: a partner may access, inspect
    //    and copy the books of the firm) ─────────────────────────────────────
    // canViewBooks = the READ-side superset of seesAllParties: partners see the
    // full books but keep NO delete/edit powers (those stay on seesAllParties).
    function isPartnerRole(appId) {
      return hasRole(appId, 'partner');
    }
    // Single hasAnyRole call, NOT seesAllParties()||isPartnerRole(): this runs
    // five times inside the deep wildcard read expression, and the expanded
    // 3-lookup form pushed non-admin reads past the rules engine's
    // 1000-expression evaluation cap (observed under the emulator).
    function canViewBooks(appId) {
      return hasAnyRole(appId, ['admin', 'accountant', 'partner']);
    }
    // Registry doc: settings/partnership. partners is a MAP keyed by empId so
    // rules can test membership. Approval POWER comes from being NAMED here —
    // not from the role — so an admin who is also a partner can approve.
    function partnershipDoc(appId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/partnership).data;
    }
    function partnershipExists(appId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/partnership);
    }
    function isNamedPartner(appId) {
      return partnershipExists(appId)
        && (userEmpId() in partnershipDoc(appId).get('partners', {}))
        && partnershipDoc(appId).get('partners', {})[userEmpId()].get('active', true) == true;
    }
    // The machinery is live only when the firm declared itself a partnership
    // (first-run wizard) AND the registry is enabled. The >=2-active-partners
    // half of partnershipActive lives client-side (rules cannot count map
    // keys); the min_partners_met flag is maintained by the admin registry
    // save and double-checked client-side before any gate engages.
    function partnershipActive(appId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/organization)
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/organization).data.get('firm_type', '') == 'partnership'
        && partnershipExists(appId)
        && partnershipDoc(appId).get('enabled', false) == true
        && partnershipDoc(appId).get('min_partners_met', false) == true;
    }
    // Spend threshold for partner counter-approval (0/absent = disabled).
    function partnerApprovalThreshold(appId) {
      return partnershipDoc(appId).get('approval_threshold', 0);
    }
    // Two-partner sign-off: a pending_actions/{id} doc must carry two signature
    // slots filled by two DIFFERENT people (each slot only ever writable with
    // the signer's own empId — see the pending_actions stanza). Gated events
    // (FY close, invoice cancellation) get() this doc by a deterministic id.
    function pendingAction(appId, id) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/pending_actions/$(id)).data;
    }
    function dualSigned(appId, id) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/pending_actions/$(id))
        && pendingAction(appId, id).get('sig1', {}).get('emp', '') != ''
        && pendingAction(appId, id).get('sig2', {}).get('emp', '') != ''
        && pendingAction(appId, id).get('sig1', {}).get('emp', '') != pendingAction(appId, id).get('sig2', {}).get('emp', '');
    }

    // ── FY lock (grey-area B7) ───────────────────────────────────────────────
    // locked_fys lives on settings/organization (Admin Tools → FY Lock). The
    // lock binds EVERYONE incl. admin — to change history, first unlock the FY
    // (an admin-only, audit-logged settings write). exists()+get() on the same
    // doc costs a single read; scoped to journal_entries writes only.
    function lockedFys(appId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/organization)
        ? get(/databases/$(database)/documents/artifacts/$(appId)/public/data/settings/organization).data.get('locked_fys', [])
        : [];
    }
    // A journal write is allowed only when NEITHER the new nor the old fy is locked.
    function jeFyUnlocked(appId) {
      return !(request.resource.data.get('fy', '') in lockedFys(appId))
        && (resource == null || !(resource.data.get('fy', '') in lockedFys(appId)));
    }

    // ── Default deny for anything outside /artifacts ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // App registry doc consumed by Cloud Functions cron. Writes are now
    // SERVER-ONLY (verifyLogin / platformCreateTenant via Admin SDK) — the old
    // client write let any authed (even anonymous) session inject arbitrary
    // appIds, a squat/flood risk once appIds are SaaS tenant codes.
    match /meta/active_apps {
      allow read: if false;
      allow write: if false;
    }

    // ── SaaS platform tree (top-level, outside /artifacts) ───────────────────
    // Exists ONLY on the SaaS project. All writes are Admin-SDK-only (platform
    // Cloud Functions); rules grant scoped READS so the console can live-query.
    // Reads are role-scoped by the staff_role claim; region/assignment scoping
    // for lists is enforced server-side by platformListTenants (per-doc rules
    // can't express list-query scoping). Inert on private (no staff tokens).
    match /platform_meta/{docId} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /platform_staff/{staffId} {
      // A staffer reads only their own profile; super_admin reads all. The
      // password hash lives in the secret/ subdoc (never readable).
      allow read: if isStaff() && (request.auth.uid == staffId || staffRole() == 'super_admin');
      allow write: if false;
      match /secret/{secretId} {
        allow read, write: if false;
      }
    }
    match /platform_tenants/{tenantId} {
      allow read: if isStaff() && (
        staffRole() == 'super_admin'
        || (staffRole() == 'regional_admin' && resource.data.region in staffData().regions)
        || (staffRole() == 'business_manager' && request.auth.uid in resource.data.assigned_managers)
      );
      allow write: if false;
    }
    match /platform_audit_logs/{docId} {
      allow read: if isStaff() && staffRole() == 'super_admin';
      allow write: if false;
    }
    // Cross-tenant credit-worthiness scores (one doc per PAN). The NUMERIC score
    // is control-plane data: readable only by a super_admin OR a staff member the
    // super_admin has marked trusted (can_view_credit on their platform_staff
    // doc). No tenant token carries `staff`, so tenants can never reach this —
    // they only ever see the colour band mirrored into their own
    // settings/credit_labels. Written solely by the Admin SDK (nightly job).
    match /platform_credit_scores/{pan} {
      allow read: if isStaff() && (staffRole() == 'super_admin' || staffData().get('can_view_credit', false) == true);
      allow write: if false;
    }

    // ── Broad catch-all for app-scoped data ───────────────────────────────────
    // NOTE: Firestore grants access if ANY matching rule permits it (OR logic).
    // Append-only collections MUST be excluded here; their specific "if false"
    // guards below would otherwise be bypassed by this wildcard's update path.
    match /artifacts/{appId}/public/data/{collection}/{docId} {

      // Reads: real (non-anonymous) authenticated sessions only.
      // audit_logs is explicitly excluded: its specific rule below restricts
      // reads to admin/accountant only (Firestore OR semantics would let
      // this wildcard override that restriction without the exclusion).
      // employees and settings are also excluded — their specific rules below
      // apply stricter checks (employees: non-anonymous; settings/security: admin).
      allow read: if isAuthed()
                  && request.auth.token.firebase.sign_in_provider != 'anonymous'
                  && collection != 'audit_logs'
                  && collection != 'employees'
                  && collection != 'settings'
                  // chat_* are excluded here so the stricter chat rules below are
                  // authoritative (OR-semantics would otherwise expose private DMs).
                  // clients is excluded so the owner-scoped client rules below are
                  // authoritative (managers see only their own clients/vendors).
                  // project_financials (field-split slice 3): the sibling holding project
                  // money is owner-scoped by the dedicated block below (admin/accountant
                  // all; a manager only their OWN projects). Excluded here so OR-semantics
                  // don't let the generic read expose every project's money.
                  // ai_usage (Phase-2 AI): Cloud-Function-written token/budget counters —
                  // excluded so the dedicated admin/accountant-read stanza is authoritative.
                  // wa_conversations: WhatsApp copilot transcripts (contain books answers)
                  // — Cloud-Function-written, admin-read only via dedicated stanza below.
                  && !(collection in ['chat_channels', 'chat_reads', 'chat_presence', 'chat_push_tokens',
                                      'employee_locations', 'location_history',
                                      'clients', 'users', 'expenses', 'project_financials', 'ai_usage',
                                      'wa_conversations'])
                  // Company-wide accounting ledgers + payroll: Owner + Accountant only.
                  // They carry no per-project owner and no operational role needs them,
                  // so they must never be SDK-readable by manager / tech / user.
                  // (payroll docs hold every employee's gross/net/deductions/rate.)
                  // reminder_log (round-9 fix): a Cloud-Function-written per-client
                  // receivables aggregate ({outstanding} = billed - received). It has
                  // no client-side reader and must not expose the debtor ledger to
                  // manager/tech/user; Admin SDK writes bypass this rule.
                  // purchase_invoices (round-17 fix): permissions.js scopes its view to
                  // admin/accountant (vendor/PO cost is not a manager's stake); it was
                  // wrongly grouped with the manager-readable invoices below, leaking
                  // every vendor's PO totals to any manager.
                  // employee_pay (field-split slice 2): the sibling holding hourlyRate/
                  // hourlyRateHistory/ctc/salary moved off the base employee doc (which
                  // every role reads for name/role/assignment). Pay = admin/accountant
                  // (view_pay) only — never manager/tech/user.
                  // canViewBooks (= admin/accountant/partner): a partner has the
                  // statutory right to inspect the books (s.12(d) Partnership Act)
                  // — read-only; every write/delete gate below stays partner-free.
                  && (canViewBooks(appId) || !(collection in [
                       'journal_entries', 'journal_drafts', 'journal_templates',
                       'chart_of_accounts', 'opening_balances', 'fiscal_year_closings',
                       'recurring_rules', 'reconcile_matches', 'reconcile_sessions',
                       'party_accounts', 'payroll', 'reminder_log', 'purchase_invoices',
                       'employee_pay']))
                  // Payroll (payouts) + advances carry employee_id: Owner/Accountant
                  // read all; everyone else reads ONLY their own record. Enforced for
                  // GET (resource.data) and for the self-scoped list query the app runs.
                  && (canViewBooks(appId) || !(collection in ['payouts', 'advances'])
                      || resource.data.get('employee_id', '') == userEmpId())
                  // Tax invoices + vendor payments + HR penalties + inventory_financials:
                  // Owner/Accountant/Manager only. Tech and Coordinator have no stake and
                  // are denied at the rule level. inventory_financials (field-split slice 1)
                  // is the sibling holding inventory rates/costs moved off the base
                  // inventory doc — managers keep read (they seed project allocations from
                  // rates); tech/user (operational stock/scan only) are denied.
                  && (canViewBooks(appId) || hasRole(appId, 'manager')
                      || !(collection in ['tax_invoices', 'vendor_payments', 'penalties', 'inventory_financials']))
                  // Leads / CRM pipeline: Owner/Accountant see all; a Manager sees ONLY
                  // leads they created (manager-vs-manager pipeline isolation); tech/user
                  // denied entirely.
                  && (canViewBooks(appId) || collection != 'leads'
                      || (hasRole(appId, 'manager') && resource.data.get('created_by', '') == userEmpId()))
                  // Payments: Owner/Accountant/Manager read all; a Coordinator (user)
                  // reads ONLY payments of clients they referred (denormalised
                  // client_owner_id == uid, for their commission); tech denied. The
                  // client_owner_id is stamped server-side by onPaymentWritten +
                  // backfillPaymentOwners.
                  && (canViewBooks(appId) || hasRole(appId, 'manager')
                      || collection != 'payments'
                      || resource.data.get('client_owner_id', '') == userEmpId())
                  // Partnership governance docs get dedicated stanzas below —
                  // excluded here so their stricter reads are authoritative.
                  && !(collection in ['partner_consents']);

      // Writes: require a recognised role (not anonymous).
      // Finance collections: admin/manager only, with extra journal_drafts guard.
      // Append-only (audit_logs, inventory_movements): blocked here; handled below.
      // Everything else: any role-bearing user (admin/manager/tech/accountant/user).
      allow create, update: if (
        // ai_usage: budget/rate-limit counters written ONLY by the AI Cloud Functions (aiExtractEntry / aiAnswerQuery / aiExtractStatement / aiExtractInvoice)
        // Cloud Function (Admin SDK) — client writes would let users forge/reset
        // the monthly AI budget meter.
        // settings (Phase-2 AI round fix): settings was excluded from the wildcard
        // READ but not WRITE/DELETE, so this rule's isRoleUser default let ANY
        // role overwrite settings/security (admin password), settings/rbac,
        // settings/ai (LLM API key), etc. via OR-semantics — defeating the
        // dedicated admin-only settings stanza. Every settings writer in the app
        // expects admin-only enforcement (Chat.jsx catch: "Only an admin can
        // change this."). Excluded here so the settings stanza is authoritative.
        collection in ['audit_logs', 'inventory_movements', 'chat_channels', 'chat_reads', 'chat_presence', 'chat_push_tokens', 'employee_locations', 'location_history', 'clients', 'users', 'expenses', 'project_financials', 'ai_usage', 'settings', 'wa_conversations', 'pending_actions', 'partner_consents']
      ) ? false
        // Inventory carries rate_per_day / purchase_cost, and penalties are salary
        // deductions — only admin/manager may create/edit them (tech/user must not
        // tamper via the SDK).
        : (collection in ['inventory', 'penalties', 'inventory_financials']) ? hasAnyRole(appId, ['admin', 'manager'])
        // Payroll (salary docs): Owner/Accountant only — a role denied even READ
        // must never be able to forge/overwrite a salary record via the SDK.
        : (collection in ['payroll', 'employee_pay']) ? hasAnyRole(appId, ['admin', 'accountant'])
        // reminder_log (round-9 fix): written only by the reminder Cloud Function
        // (Admin SDK bypasses rules). No client writes it; lock SDK writes to
        // admin/accountant so tech/user cannot forge/overwrite the receivables log.
        : (collection == 'reminder_log') ? seesAllParties(appId)
        // Leads / CRM (round-9 fix): READ is scoped to admin/accountant (all) + a
        // manager's OWN leads (created_by, lines above). Writes MUST match, or the
        // read-side manager-vs-manager isolation is defeated: admin/accountant write
        // any; a manager may create a lead only with their own created_by and may
        // edit only leads they created; tech/user (who cannot even read leads) denied.
        : (collection == 'leads') ? (
            seesAllParties(appId)
            || (hasRole(appId, 'manager') && (
                 (resource == null && request.resource.data.get('created_by', '') == userEmpId())
                 || (resource != null && resource.data.get('created_by', '') == userEmpId())
               ))
          )
        : (
        collection in ['recurring_rules', 'reconcile_matches', 'reconcile_sessions',
                       'journal_entries', 'journal_drafts', 'journal_templates',
                       'chart_of_accounts',
                       'opening_balances', 'fiscal_year_closings',
                       'payments', 'payouts', 'advances', 'vendor_payments',
                       'tax_invoices', 'purchase_invoices', 'party_accounts']
      ) ? (
          // Review-only metadata update on an AI journal entry — allow any finance
          // role (incl. accountant) to flag it reviewed without unlocking financials.
          // (Deliberately exempt from the FY lock below: review stamps on old
          // entries are metadata-only and desirable even after locking.)
          (collection == 'journal_entries' && resource != null
            && hasAnyRole(appId, ['admin', 'accountant', 'manager'])
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['ai_reviewed', 'ai_reviewed_by', 'ai_reviewed_by_name', 'ai_reviewed_at']))
          // FY lock (grey-area B7): journal entries dated in a locked FY are
          // frozen for EVERYONE incl. admin — unlock the FY in Admin Tools first.
          || ((collection != 'journal_entries' || jeFyUnlocked(appId)) &&
          // Managers may WRITE only the transactional collections they legitimately
          // use (payments receipt, own-client tax invoices, vendor payments). The
          // pure accounting ledgers (journal/chart/opening/fiscal/recurring/reconcile/
          // payouts/purchase_invoices) require admin/accountant — a manager must not
          // create/overwrite GL data it cannot even read.
          // party_accounts is admin/accountant only (round-7 fix): its READ is already
          // admin/accountant-only, and the client-upsert side-write (upsertPartyAccount)
          // does a getDoc first that a manager cannot pass, so managers never wrote it
          // in practice — this closes the unbounded cross-party tamper hole.
          (((collection in ['payments', 'tax_invoices', 'vendor_payments'])
                 ? (isFinanceWriter(appId)
                    // A pure-partner role may reach vendor_payments ONLY to write
                    // its partner-approval decision (the clause below pins the
                    // diff to the approval fields for them).
                    || (collection == 'vendor_payments' && isPartnerRole(appId) && partnershipActive(appId)))
                 : (seesAllParties(appId)
                    // …and journal_drafts ONLY for the approval-decision branch.
                    || (collection == 'journal_drafts' && isPartnerRole(appId) && partnershipActive(appId)))) && (
            collection != 'journal_drafts'
            // Proprietorship: admin keeps today's full control. Partnership: even
            // the admin is bound by no-self-approval — approval-field writes must
            // stamp approved_by = the CALLER, and the caller must not be the
            // draft's creator ("no self-approval anywhere", s.12 fiduciary duty).
            || (isAdmin(appId) && !partnershipActive(appId))
            || ((isAdmin(appId) || isNamedPartner(appId))
                && partnershipActive(appId)
                && resource != null
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['approval_status', 'approved_by', 'approved_at', 'rejection_reason'])
                && request.resource.data.get('approved_by', '') == userEmpId()
                && resource.data.get('created_by', '') != userEmpId())
            // CREATE: managers may set approval_status to 'pending' only; no approver stamps.
            || (resource == null
                && (!('approval_status' in request.resource.data) ||
                    request.resource.data.approval_status == 'pending' ||
                    request.resource.data.approval_status == null)
                && (!('approved_by' in request.resource.data) ||
                    request.resource.data.approved_by == null)
                && (!('approved_at' in request.resource.data) ||
                    request.resource.data.approved_at == null)
                && (!('rejection_reason' in request.resource.data) ||
                    request.resource.data.rejection_reason == null))
            // UPDATE: approval fields must not be in the diff. (Content edits —
            // not for the pure-partner role, which only decides approvals.)
            || (resource != null
                && !isPartnerRole(appId)
                && !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['approval_status', 'approved_by',
                             'approved_at', 'rejection_reason']))
          )
          // ── Partnership spend threshold: vendor payments (money OUT) ───────
          // When the firm is a partnership with a threshold set, a vendor
          // payment ABOVE it must be born 'pending' with no approver stamps;
          // the partner-approval fields are writable only by a NAMED partner
          // who is not the creator (no self-approval); and raising the amount
          // past the threshold on an existing doc sends it back to pending.
          && (collection != 'vendor_payments' || !partnershipActive(appId) || (
            (resource == null
              ? (partnerApprovalThreshold(appId) <= 0
                 || request.resource.data.get('amount', 0) <= partnerApprovalThreshold(appId)
                 || (request.resource.data.get('partner_approval_status', '') == 'pending'
                     && request.resource.data.get('partner_approved_by', null) == null
                     && request.resource.data.get('partner_approved_at', null) == null
                     && request.resource.data.get('created_by_emp', '') == userEmpId()))
              : (
                  // approval-field writes: either a RESET to pending (stamps
                  // cleared — e.g. the amount was raised and the doc must go
                  // back for counter-approval), or a DECISION by a named
                  // partner with their own stamp who is not the creator.
                  (!request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['partner_approval_status', 'partner_approved_by', 'partner_approved_at', 'partner_rejection_reason'])
                   || (request.resource.data.get('partner_approval_status', '') == 'pending'
                       && request.resource.data.get('partner_approved_by', null) == null)
                   || (isNamedPartner(appId)
                       && request.resource.data.get('partner_approved_by', '') == userEmpId()
                       && resource.data.get('created_by_emp', '') != userEmpId()))
                  // a pure-partner role may ONLY write the approval fields
                  && (!isPartnerRole(appId)
                      || request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['partner_approval_status', 'partner_approved_by', 'partner_approved_at', 'partner_rejection_reason']))
                  // amount raised past the threshold → must return to pending
                  && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount'])
                      || partnerApprovalThreshold(appId) <= 0
                      || request.resource.data.get('amount', 0) <= partnerApprovalThreshold(appId)
                      || request.resource.data.get('partner_approval_status', '') == 'pending')
                ))
          ))
          // ── Partnership dual sign-off: FY close ────────────────────────────
          // Closing a fiscal year is a firm-level event (s.19(2) spirit): when
          // the partnership is active, the fiscal_year_closings doc may be
          // created only after TWO different named partners signed the
          // pending_actions/fy_close_{fy} request. Doc id == the FY label.
          && (collection != 'fiscal_year_closings' || resource != null
              || !partnershipActive(appId)
              || dualSigned(appId, 'fy_close_' + docId))
          // ── tax_invoices immutability guards ───────────────────────────────
          // These fields are locked once the invoice is created (resource != null = UPDATE).
          // invoice_no: immutable — changing a number post-issue breaks GSTR-1 continuity.
          // org_gstin_at_issue / supply_type / *_amount: immutable — changing these
          //   would silently corrupt the GST split already reported to the buyer.
          // invoice_date: admin-only change — needed for rare correction scenarios
          //   but too risky for manager-level edits (affects tax period allocation).
          && (collection != 'tax_invoices' || resource == null || (
            request.resource.data.invoice_no == resource.data.invoice_no
            && request.resource.data.get('org_gstin_at_issue', '') == resource.data.get('org_gstin_at_issue', '')
            && request.resource.data.get('supply_type', '') == resource.data.get('supply_type', '')
            && request.resource.data.get('cgst_amount', 0) == resource.data.get('cgst_amount', 0)
            && request.resource.data.get('sgst_amount', 0) == resource.data.get('sgst_amount', 0)
            && request.resource.data.get('igst_amount', 0) == resource.data.get('igst_amount', 0)
            && (request.resource.data.get('invoice_date', '') == resource.data.get('invoice_date', '')
                || isAdmin(appId))
            // status → 'Cancelled' is admin-only (Section 34 CGST Act workflow).
            // Partnership: cancellation additionally needs TWO partner
            // signatures on pending_actions/invoice_cancel_{docId} — an issued
            // GST invoice is firm-level history, not one person's call.
            && (request.resource.data.get('status', '') != 'Cancelled'
                || resource.data.get('status', '') == 'Cancelled'
                || (isAdmin(appId)
                    && (!partnershipActive(appId)
                        || dualSigned(appId, 'invoice_cancel_' + docId))))
          ))
          // ── payments segregation-of-duties guard (round-13 fix) ────────────
          // Owner/Accountant record AND approve payments. A manager may only CREATE
          // a receipt in the mandatory 'Pending Review' status with no approver
          // stamps — a manager must NOT self-approve (status 'Approved') on create,
          // nor update/approve an existing payment (that is Owner/Accountant's job).
          // The UI already forces manager receipts to 'Pending Review'
          // (Clients.jsx / Finance.jsx); this enforces it at the SDK layer.
          // Partnership no-self-approval: even an Owner/Accountant approving a
          // payment must stamp themselves and must not be its recorder.
          && (collection != 'payments' || !partnershipActive(appId) || resource == null
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
              || request.resource.data.get('status', '') != 'Approved'
              || (request.resource.data.get('approved_by', '') == userEmpId()
                  && resource.data.get('recorded_by', '') != userEmpId()))
          && (collection != 'payments' || seesAllParties(appId) || (
            resource == null
            && request.resource.data.get('status', '') == 'Pending Review'
            && request.resource.data.get('approved_by', null) == null
            && request.resource.data.get('approved_at', null) == null
            // Round-16: own-client only — the receipt stamps client_owner_id =
            // the client's owner (Clients.jsx), which for a manager's own client is
            // their own uid. Blocks crafting a receipt against another manager's
            // client. onPaymentWritten re-stamps this from the client server-side.
            && request.resource.data.get('client_owner_id', '') == userEmpId()
          ))
          // ── chart_of_accounts isSystem guard (grey-area C4) ────────────────
          // System-seeded account heads keep their identity: name/type/normal
          // side/isSystem are immutable (isActive + subType/code edits stay open
          // for the deactivation feature).
          && (collection != 'chart_of_accounts' || resource == null
              || resource.data.get('isSystem', false) != true
              || !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['name', 'type', 'normalSide', 'isSystem']))
          ))
        ) : isRoleUser(appId);  // DEFAULT: any recognised role; closes anonymous write

      // Deletes:
      //   - append-only / privacy collections: nobody here (their own rules apply).
      //   - pure GL ledgers: admin only.
      //   - finance/accounting docs a manager can neither READ nor CREATE
      //     (payroll, payouts, advances, party_accounts, purchase_invoices,
      //     reconcile_sessions, journal_drafts, journal_templates): admin/accountant
      //     only. ROUND-7 FIX: the old default let isFinanceWriter (which INCLUDES
      //     manager) delete these, so a manager could destroy salary/payout/advance/
      //     GL-draft records it is walled off from everywhere else. Delete must mirror
      //     the create/read gate: seesAllParties = admin/accountant.
      //   - everything else (manager-transactional payments/tax_invoices/
      //     vendor_payments + operational collections): admin/accountant/manager.
      allow delete: if (
        // ai_usage: deletes would reset the AI budget meter — Cloud Function only.
        // settings: same wildcard-vs-stanza fix as create/update above — deletes
        // of settings docs must go through the admin-only settings stanza.
        collection in ['audit_logs', 'inventory_movements', 'chat_channels', 'chat_reads', 'chat_presence', 'chat_push_tokens', 'employee_locations', 'location_history', 'clients', 'users', 'expenses', 'project_financials', 'ai_usage', 'settings', 'wa_conversations', 'pending_actions', 'partner_consents']
      ) ? false
        // journal_entries: admin-only AND never inside a locked FY (B7) — a
        // hard delete in a locked year would silently rewrite closed books.
        : (collection == 'journal_entries')
          ? (isAdmin(appId) && !(resource.data.get('fy', '') in lockedFys(appId)))
        // chart_of_accounts: admin-only AND never a system-seeded head (C4).
        : (collection == 'chart_of_accounts')
          ? (isAdmin(appId) && resource.data.get('isSystem', false) != true)
        : (
        collection in ['reconcile_matches',
                       'recurring_rules', 'fiscal_year_closings',
                       'opening_balances']
      ) ? isAdmin(appId)
        : (collection in ['payroll', 'employee_pay', 'payouts', 'advances', 'party_accounts',
                          'purchase_invoices', 'reconcile_sessions',
                          'journal_drafts', 'journal_templates', 'reminder_log',
                          // tax_invoices (round-15 fix): a manager may CREATE invoices
                          // but permissions.js locks tax_invoices.delete to admin/
                          // accountant (GSTR-1 continuity + the invoice-immutability
                          // guards a raw delete would bypass). The isFinanceWriter
                          // default previously let any manager destroy any GST invoice.
                          'tax_invoices']) ? seesAllParties(appId)
        // inventory + penalties (round-14 fix): delete must mirror their CREATE gate
        // (line ~159 = admin/manager), NOT the isFinanceWriter default — an accountant
        // is view-only on these (permissions.js hr_penalties/inventory) and must not
        // be able to delete a salary-deduction or inventory record it cannot create.
        : (collection in ['inventory', 'penalties', 'inventory_financials']) ? hasAnyRole(appId, ['admin', 'manager'])
        // Leads (round-9 fix): admin/accountant delete any; a manager deletes ONLY
        // leads they created (the old isFinanceWriter default let Manager B delete
        // Manager A's lead, defeating manager-vs-manager pipeline isolation).
        : (collection == 'leads') ? (seesAllParties(appId)
            || (hasRole(appId, 'manager') && resource.data.get('created_by', '') == userEmpId()))
        : isFinanceWriter(appId);
    }

    // ── Audit logs ────────────────────────────────────────────────────────────
    // Append-only: any role-bearing user may create; nobody may edit or delete.
    // Read restricted to admin and accountant (matches the permissions model).
    match /artifacts/{appId}/public/data/audit_logs/{docId} {
      // Owner + partners (s.12(d): a partner may inspect the books, and the
      // audit trail is part of the record of the firm).
      allow read: if hasRole(appId, 'admin') || isPartnerRole(appId);
      allow create: if isRoleUser(appId);
      allow update, delete: if false;
    }

    // ── Inventory movements ───────────────────────────────────────────────────
    // Append-only mirror of challan saves.  Any role-bearing user may append;
    // nobody may edit or delete to preserve the truthful trail.
    match /artifacts/{appId}/public/data/inventory_movements/{docId} {
      allow read: if isAuthed();
      allow create: if isRoleUser(appId);
      allow update, delete: if false;
    }

    // ── Project financials (field-split slice 3) ───────────────────────────────
    // Sibling holding a project's money (items$/package_cost/logistics/vendor_
    // allocations/purchase_orders/reimbursable/margin/totals), written ONLY by the
    // onProjectWritten Cloud Function (Admin SDK). Read is owner-scoped: admin/
    // accountant see all; a manager sees ONLY their own projects (client_owner_id or
    // created_by == their uid, denormalised onto the sibling by the trigger). Read is
    // OWNERSHIP-based, not role-based: admin/accountant see all; anyone who OWNS the
    // project sees it — a Manager for their own projects, AND a Coordinator (user) for
    // clients they referred (client_owner_id == their uid), which their commission page
    // needs. A non-owner (incl. tech, and other managers) never reads it. Client
    // writes/deletes denied — the trigger (Admin SDK) is the sole writer.
    match /artifacts/{appId}/public/data/project_financials/{pid} {
      allow read: if isAuthed()
                  && request.auth.token.firebase.sign_in_provider != 'anonymous'
                  // canViewBooks: partners see all project money (s.12(d)).
                  && (canViewBooks(appId)
                      || resource.data.get('client_owner_id', '') == userEmpId()
                      || resource.data.get('created_by', '') == userEmpId());
      allow write: if false; // Admin SDK trigger only
    }

    // ── Expenses ──────────────────────────────────────────────────────────────
    // All role-bearing users may submit their own expenses (create).
    // Edit/approval restricted to admin, accountant, manager; or the owner of
    // the record for minor self-corrections.
    // Delete restricted to admin and accountant only.
    match /artifacts/{appId}/public/data/expenses/{docId} {
      // Read: admin/accountant/manager/partner see all; everyone else (tech/user)
      // reads ONLY their own expenses (amounts are financial — no company-wide read).
      allow read: if isAuthed()
                  && request.auth.token.firebase.sign_in_provider != 'anonymous'
                  && (hasAnyRole(appId, ['admin', 'accountant', 'manager', 'partner'])
                      || resource.data.get('employee_id', '') == userEmpId());
      // Partnership spend threshold: an expense ABOVE the configured threshold
      // must be born WITHOUT an Approved status (it goes through the normal
      // Pending flow AND partner counter-approval fields, journal-drafts style).
      allow create: if isRoleUser(appId)
                    && (!partnershipActive(appId)
                        || partnerApprovalThreshold(appId) <= 0
                        || request.resource.data.get('amount', 0) <= partnerApprovalThreshold(appId)
                        || (request.resource.data.get('status', '') != 'Approved'
                            && request.resource.data.get('partner_approval_status', '') == 'pending'
                            && request.resource.data.get('partner_approved_by', null) == null));
      allow update: if (
                      (hasAnyRole(appId, ['admin', 'accountant', 'manager'])
                        // Partnership no-self-approval: whoever flips an expense to
                        // Approved must stamp approved_by = self and must not be the
                        // spender. (Proprietorships keep today's behaviour.)
                        && (!partnershipActive(appId)
                            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                            || request.resource.data.get('status', '') != 'Approved'
                            || (request.resource.data.get('approved_by', '') == userEmpId()
                                && resource.data.get('employee_id', '') != userEmpId()))
                        // …and above-threshold expenses need the partner counter-
                        // approval BEFORE they can be flipped to Approved.
                        && (!partnershipActive(appId)
                            || partnerApprovalThreshold(appId) <= 0
                            || request.resource.data.get('amount', 0) <= partnerApprovalThreshold(appId)
                            || request.resource.data.get('status', '') != 'Approved'
                            || request.resource.data.get('partner_approval_status', '') == 'approved'))
                      // A NAMED partner (any role) may write the partner-approval
                      // fields — never on their own expense.
                      || (partnershipActive(appId) && isNamedPartner(appId)
                          && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['partner_approval_status', 'partner_approved_by', 'partner_approved_at', 'partner_rejection_reason'])
                          && request.resource.data.get('partner_approved_by', '') == userEmpId()
                          && resource.data.get('employee_id', '') != userEmpId())
                      || (isRoleUser(appId)
                          && resource.data.employee_id == userEmpId()
                          && resource.data.status == 'Pending'
                          // Owner self-corrections MUST keep the record Pending — a
                          // submitter can fix their own amount/description but can NEVER
                          // self-approve (approve = admin/accountant/manager per
                          // permissions.js) nor reassign it to another employee, nor
                          // touch the partner-approval fields.
                          && request.resource.data.status == 'Pending'
                          && request.resource.data.employee_id == userEmpId()
                          && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['partner_approval_status', 'partner_approved_by', 'partner_approved_at'])));
      allow delete: if hasAnyRole(appId, ['admin', 'accountant']);
    }

    // ── Settings ──────────────────────────────────────────────────────────────
    // Secret-bearing settings docs (security, communication, payments, einvoice):
    //   admin-read only. Cloud Functions access them via Admin SDK (bypasses
    //   rules). All other settings docs: any real (non-anonymous) session.
    // Write: admin only.
    match /artifacts/{appId}/public/data/settings/{docId} {
      // settings/ai holds the LLM API key — NEVER client-readable, not even by
      // admin (the AI Cloud Functions read it via Admin SDK, which
      // bypasses rules). AdminTools writes it blind and displays state from the
      // non-secret sibling settings/ai_public instead.
      allow read: if docId == 'ai'
                    ? false
                    : (docId in ['security', 'communication', 'payments', 'einvoice', 'whatsapp'])
                      ? isAdmin(appId)
                      : (isAuthed() && request.auth.token.firebase.sign_in_provider != 'anonymous');
      // settings/entitlements is the tenant's plan-resolved features/limits and
      // settings/credit_labels is the credit-worthiness colour projection: the
      // tenant may READ both (to gate its UI / show party colours) but only the
      // platform Admin SDK may write them — otherwise a tenant admin could grant
      // themselves paid features or forge a party's credit colour.
      // settings/partnership is firm GOVERNANCE: once the partnership is live,
      // the admin cannot unilaterally rewrite it (disable the module, drop the
      // threshold, remove a partner) — that class of change needs two partner
      // signatures on pending_actions/partnership_settings first (same
      // binds-the-owner philosophy as the FY lock). Initial setup (doc absent
      // or machinery not yet active) stays admin-only so onboarding works.
      allow write: if docId in ['entitlements', 'credit_labels'] ? false
                   : (docId == 'partnership'
                      ? (isAdmin(appId)
                         && (!partnershipActive(appId)
                             || dualSigned(appId, 'partnership_settings')))
                      : isAdmin(appId));
    }

    // ── Partnership: dual-sign pending actions ────────────────────────────────
    // A request for a two-partner sign-off (FY close, invoice cancellation,
    // governance change). Each signature slot is only ever writable with the
    // SIGNER'S OWN empId, by a named partner; sig2 must differ from sig1. The
    // payload freezes at creation. Deletes: admin (cleanup of consumed/stale
    // requests) — deleting can only ever REVOKE an authorisation, never grant.
    match /artifacts/{appId}/public/data/pending_actions/{docId} {
      allow read: if canViewBooks(appId) || isNamedPartner(appId);
      allow create: if (isAdmin(appId) || isNamedPartner(appId))
                    && request.resource.data.get('initiated_by', '') == userEmpId()
                    && request.resource.data.get('sig2', null) == null
                    && (request.resource.data.get('sig1', null) == null
                        || (isNamedPartner(appId)
                            && request.resource.data.get('sig1', {}).get('emp', '') == userEmpId()));
      allow update: if isNamedPartner(appId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sig1', 'sig2'])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sig1'])
                        || (resource.data.get('sig1', null) == null
                            && request.resource.data.get('sig1', {}).get('emp', '') == userEmpId()))
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sig2'])
                        || (resource.data.get('sig2', null) == null
                            && request.resource.data.get('sig2', {}).get('emp', '') == userEmpId()
                            && request.resource.data.get('sig1', {}).get('emp', '') != userEmpId()));
      allow delete: if isAdmin(appId);
    }

    // ── Partnership: consent register (s.12(c) Partnership Act) ───────────────
    // Recorded resolutions: ordinary matters pass by MAJORITY of active
    // partners; fundamental changes (nature of business, admitting a partner —
    // s.31) need ALL. Each partner may write ONLY their own vote_{empId} field
    // while the resolution is open; closed resolutions are immutable evidence.
    // The stored outcome is stamped by the closing client and is recomputable
    // from the recorded votes at any time (the votes are the authority).
    match /artifacts/{appId}/public/data/partner_consents/{docId} {
      allow read: if canViewBooks(appId) || isNamedPartner(appId);
      allow create: if isNamedPartner(appId)
                    && request.resource.data.get('proposed_by', '') == userEmpId()
                    && request.resource.data.get('status', '') == 'open'
                    && request.resource.data.get('category', '') in ['ordinary', 'fundamental'];
      allow update: if resource.data.get('status', '') == 'open'
                    && (
                      // a partner casting/changing their OWN vote
                      (isNamedPartner(appId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['vote_' + userEmpId()]))
                      // closing: outcome stamp (passed/rejected by any named
                      // partner or admin; withdrawn only by the proposer)
                      || ((isNamedPartner(appId) || isAdmin(appId))
                          && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['status', 'closed_at', 'closed_by'])
                          && request.resource.data.get('status', '') in ['passed', 'rejected', 'withdrawn']
                          && request.resource.data.get('closed_by', '') == userEmpId()
                          && (request.resource.data.get('status', '') != 'withdrawn'
                              || resource.data.get('proposed_by', '') == userEmpId()))
                    );
      allow delete: if false; // permanent record
    }

    // ── WhatsApp copilot conversations ────────────────────────────────────────
    // Inbound messages + AI replies, written ONLY by the WhatsApp Cloud
    // Functions via the Admin SDK. Transcripts contain books answers, so
    // reads are admin-only. Excluded from the broad wildcard above.
    match /artifacts/{appId}/public/data/wa_conversations/{docId} {
      allow read: if isAdmin(appId);
      allow write: if false;
    }

    // ── AI usage metering (Phase-2 AI assistant) ──────────────────────────────
    // Monthly token counters (usage_{YYYY-MM}) and per-user rate-limit windows
    // (rl_{uid} / rl_qa_{uid} / rl_stmt_{uid} / rl_inv_{uid}), written ONLY by the AI Cloud Functions via the
    // Admin SDK. Excluded from the broad wildcard (read AND write) above so
    // clients can never forge or reset the AI budget. Admin/Accountant read the
    // usage meter in Admin Tools.
    match /artifacts/{appId}/public/data/ai_usage/{docId} {
      allow read: if seesAllParties(appId);
      allow write: if false;
    }

    // ── Employees ─────────────────────────────────────────────────────────────
    // Read: real (non-anonymous) authenticated sessions only.
    //   The verifyLogin Cloud Function handles all login-time credential lookups
    //   server-side, so the login page no longer needs anonymous reads here.
    // Create/delete: admin only.
    // Update: admin full access; any role-bearing user may update their own
    //         non-role fields (profile photo, contact details, etc.).
    match /artifacts/{appId}/public/data/employees/{empId} {
      allow read: if isAuthed() && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create, delete: if isAdmin(appId);
      allow update: if isAdmin(appId) ||
                    (isRoleUser(appId) && empId == userEmpId() &&
                     !('role' in request.resource.data.diff(resource.data).affectedKeys()));
    }

    // ── Users auth mirror ─────────────────────────────────────────────────────
    // Each authenticated Firebase Auth user owns a /users/{uid} doc that records
    // their role, used by userRole() for server-side rule evaluation.
    //
    // PRIVILEGE ESCALATION FIX: a user writing their own mirror may not set the
    // 'role' field to any value other than what their canonical /employees/{uid}
    // doc already holds.  This prevents a low-privilege user from self-promoting
    // by calling setDoc({ role: 'admin' }) directly on the SDK.
    //
    // Admin can manage all mirrors (needed for role changes that go through the
    // RBAC manager UI, which also updates the employee record first).
    match /artifacts/{appId}/public/data/users/{uid} {
      allow read: if isAuthed() && (uid == userEmpId() || isAdmin(appId));

      // Self-create/update: the role field may ONLY equal the caller's OWN
      // employee record (employees/{auth.uid}). verifyLogin always mints the
      // custom token with uid == employee id, so this covers every real login.
      // NOTE: a previous variant also accepted a client-supplied employee_id and
      // matched the role against THAT employee — which let any authenticated
      // employee self-promote to admin by supplying an admin's id. Removed.
      function empRoleMatches(empId) {
        return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(empId)) &&
               request.resource.data.role ==
                 get(/databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(empId)).data.role;
      }
      allow create: if isAuthed() && uid == userEmpId() && (
        !('role' in request.resource.data) ||
        empRoleMatches(userEmpId())
      );

      // Self-update: role may only be changed to the value in the caller's own
      // employee record.
      allow update: if isAdmin(appId) || (
        isAuthed() && uid == userEmpId() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          empRoleMatches(userEmpId())
        )
      );

      allow delete: if isAdmin(appId);
    }

    // ── Team chat ─────────────────────────────────────────────────────────────
    // chat_channels + their /messages subcollection, plus per-user chat_reads,
    // chat_presence and chat_push_tokens. These collections are EXCLUDED from the
    // broad wildcard above so the rules here are authoritative (Firestore
    // OR-semantics would otherwise let the wildcard's open read override DM
    // privacy). Open channels (team/announcement) are readable by any real user;
    // private channels (dm/project) only by a listed member or management.
    // Each message carries a denormalised channel_type + members so reads
    // authorise without a cross-document lookup.
    function chatCanRead(appId, ctype, members) {
      return isAuthed()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (ctype == 'team' || ctype == 'announcement'
            || (members is list && userEmpId() in members)
            || hasAnyRole(appId, ['admin', 'manager']));
    }

    match /artifacts/{appId}/public/data/chat_channels/{cid} {
      allow read: if chatCanRead(appId, resource.data.get('type', ''), resource.data.get('members', []));
      allow create, update: if isRoleUser(appId)
        && (request.resource.data.type == 'team'
            || request.resource.data.type == 'announcement'
            || (request.resource.data.members is list && userEmpId() in request.resource.data.members)
            || hasAnyRole(appId, ['admin', 'manager']));
      allow delete: if hasAnyRole(appId, ['admin', 'manager']);

      match /messages/{mid} {
        allow read: if chatCanRead(appId, resource.data.get('channel_type', ''), resource.data.get('members', []));
        // Sender must be the caller; announcements are management-only to post;
        // dm/project require membership; team is open to any role user.
        allow create: if isRoleUser(appId)
          && request.resource.data.sender_id == userEmpId()
          && (request.resource.data.channel_type == 'team'
              || (request.resource.data.channel_type == 'announcement' && hasAnyRole(appId, ['admin', 'manager']))
              || (request.resource.data.channel_type in ['dm', 'project']
                  && request.resource.data.members is list
                  && userEmpId() in request.resource.data.members));
        // Author may edit / soft-delete own message; management may moderate.
        allow update: if isRoleUser(appId)
          && (resource.data.sender_id == userEmpId() || hasAnyRole(appId, ['admin', 'manager']));
        allow delete: if hasAnyRole(appId, ['admin', 'manager']);
      }
    }

    // Per-user read cursors (unread counts + read receipts). Readable by any role
    // user (so "seen by" works); each person writes only their own cursor.
    match /artifacts/{appId}/public/data/chat_reads/{rid} {
      allow read: if isRoleUser(appId);
      allow create, update: if isRoleUser(appId) && request.resource.data.emp_id == userEmpId();
      allow delete: if false;
    }

    // Online presence. Readable by any role user; each person writes only their own.
    match /artifacts/{appId}/public/data/chat_presence/{empId} {
      allow read: if isRoleUser(appId);
      allow create, update, delete: if isRoleUser(appId) && empId == userEmpId();
    }

    // Push device tokens. Not client-readable (functions use the Admin SDK);
    // each user registers/removes only their own tokens.
    match /artifacts/{appId}/public/data/chat_push_tokens/{token} {
      allow read: if false;
      allow create, update: if isRoleUser(appId) && request.resource.data.emp_id == userEmpId();
      allow delete: if isRoleUser(appId) && (resource.data.emp_id == userEmpId() || isAdmin(appId));
    }

    // ── Employee location tracking ─────────────────────────────────────────────
    // Privacy: excluded from the open-read wildcard above. An employee writes only
    // their own location; reads are limited to themselves and management. History
    // is management-read only and append-only (pruned by a scheduled function via
    // the Admin SDK).
    match /artifacts/{appId}/public/data/employee_locations/{empId} {
      allow read: if isAuthed()
                  && request.auth.token.firebase.sign_in_provider != 'anonymous'
                  && (empId == userEmpId() || hasAnyRole(appId, ['admin', 'manager']));
      allow create, update: if isRoleUser(appId) && empId == userEmpId();
      allow delete: if hasAnyRole(appId, ['admin', 'manager']);
    }
    match /artifacts/{appId}/public/data/location_history/{docId} {
      allow read: if hasAnyRole(appId, ['admin', 'manager']);
      allow create: if isRoleUser(appId) && request.resource.data.emp_id == userEmpId();
      allow update: if false;
      allow delete: if hasAnyRole(appId, ['admin', 'manager']);
    }

    // ── Client / vendor ownership scoping ──────────────────────────────────────
    // Excluded from the generic wildcard above so these owner-scoped rules are
    // authoritative. Admin + Accountant see all; everyone else sees only clients
    // they own (owner_id == their employee id = auth.uid). A manager may create/
    // edit only clients they own and cannot reassign ownership; admin reassigns.
    // Only the MANAGER role is isolated (manager-vs-manager): a manager reads only
    // clients they own. Admin, accountant, user and tech keep full visibility
    // (zero behaviour change for them).
    match /artifacts/{appId}/public/data/clients/{cid} {
      // Admin + Accountant read all; everyone else (manager/tech/user) reads only
      // clients they OWN. Tech/Coordinator own none, so they cannot SDK-read raw
      // client docs (which carry opening_balance / referral_rate) — they use the
      // stripped getContacts function instead.
      allow read: if isAuthed()
                  && request.auth.token.firebase.sign_in_provider != 'anonymous'
                  // canViewBooks: a partner reads the full client book (s.12(d));
                  // writes below stay admin/manager as before.
                  && (canViewBooks(appId) || resource.data.get('owner_id', '') == userEmpId());
      allow create: if isAdmin(appId)
                    || (hasRole(appId, 'manager') && request.resource.data.get('owner_id', '') == userEmpId());
      allow update: if isAdmin(appId)
                    || (hasRole(appId, 'manager')
                        && resource.data.get('owner_id', '') == userEmpId()
                        && request.resource.data.get('owner_id', '') == userEmpId());
      allow delete: if isAdmin(appId);
    }
    // NOTE: project READS are intentionally NOT hard-scoped. Per the owner's
    // model a MANAGER sees OTHER projects OPERATIONALLY (shared calendar /
    // schedule / inventory-conflict view) with all financial fields stripped in
    // the UI (projectFinanceVisible in Projects.jsx et al. — a manager sees money
    // only on projects whose client they own). Financials are embedded in the
    // project document, so field-level hiding is enforced in the UI; a future
    // phase may split financial fields into a guarded subcollection for true
    // server-side enforcement. tech/user assigned-only scoping is likewise
    // deferred (risks dispatch/challan flows) pending a non-admin test login.
  }
}

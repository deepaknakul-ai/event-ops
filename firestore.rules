rules_version = '2';

// Rental-Ops Firestore rules (Phase 6 — Security Hardening).
// Deploy with:  firebase deploy --only firestore:rules
//
// Security model:
//   - All app data lives under /artifacts/{appId}/public/data/{collection}/{doc}
//   - Reads are open to any authenticated session (anonymous sessions are used
//     by the login page to read employees/settings before credentials are
//     verified — a known design constraint).
//   - Writes ALWAYS require a recognised role (admin/accountant/manager/tech/user).
//     Anonymous sessions cannot write anything.
//   - Finance-sensitive collections additionally require admin or manager.
//   - Append-only collections (audit_logs, inventory_movements) are explicitly
//     excluded from the broad wildcard update path so the specific "if false"
//     guards below cannot be bypassed via OR semantics.
//   - The /users/{uid} role mirror is constrained: self-writes may not set the
//     role field to any value other than what the canonical /employees/{uid}
//     doc already holds, closing the privilege-escalation path.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    function userEmpId() {
      return request.auth.uid;
    }

    // Role lookup: /users/{uid} mirror first (written on login upgrade),
    // falls back to /employees/{uid} for the migration window.
    function userRole(appId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(userEmpId()))
        ? get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(userEmpId())).data.role
        : get(/databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(userEmpId())).data.role;
    }

    function hasRole(appId, role) {
      return isAuthed() && userRole(appId) == role;
    }

    function hasAnyRole(appId, roles) {
      return isAuthed() && (userRole(appId) in roles);
    }

    // isRoleUser: authenticated AND holds any recognised role.
    // Prevents anonymous sessions from writing (closes the broad isAuthed() gap).
    function isRoleUser(appId) {
      return hasAnyRole(appId, ['admin', 'accountant', 'manager', 'tech', 'user']);
    }

    function isFinanceWriter(appId) {
      return hasAnyRole(appId, ['admin', 'manager']);
    }

    function isAdmin(appId) {
      return hasRole(appId, 'admin');
    }

    // ── Default deny for anything outside /artifacts ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // App registry doc consumed by Cloud Functions cron.
    match /meta/active_apps {
      allow read: if false;
      allow create, update: if isAuthed();
      allow delete: if false;
    }

    // ── Broad catch-all for app-scoped data ───────────────────────────────────
    // NOTE: Firestore grants access if ANY matching rule permits it (OR logic).
    // Append-only collections MUST be excluded here; their specific "if false"
    // guards below would otherwise be bypassed by this wildcard's update path.
    match /artifacts/{appId}/public/data/{collection}/{docId} {

      // Reads: isAuthed() is intentionally broad — anonymous sessions need to
      // read employees/settings for the login page.
      // audit_logs is explicitly excluded: its specific rule below restricts
      // reads to admin/accountant only (and Firestore OR semantics would let
      // the wildcard override that restriction without this exclusion).
      allow read: if isAuthed() && collection != 'audit_logs';

      // Writes: require a recognised role (not anonymous).
      // Finance collections: admin/manager only, with extra journal_drafts guard.
      // Append-only (audit_logs, inventory_movements): blocked here; handled below.
      // Everything else: any role-bearing user (admin/manager/tech/accountant/user).
      allow create, update: if (
        collection in ['audit_logs', 'inventory_movements']
      ) ? false
        : (
        collection in ['recurring_rules', 'reconcile_matches', 'reconcile_sessions',
                       'journal_entries', 'journal_drafts', 'journal_templates',
                       'chart_of_accounts',
                       'opening_balances', 'fiscal_year_closings',
                       'payments', 'payouts', 'vendor_payments',
                       'tax_invoices', 'purchase_invoices']
      ) ? (
          isFinanceWriter(appId) && (
            collection != 'journal_drafts'
            || isAdmin(appId)
            // CREATE: managers may set approval_status to 'pending' only; no approver stamps.
            || (resource == null
                && (!('approval_status' in request.resource.data) ||
                    request.resource.data.approval_status == 'pending' ||
                    request.resource.data.approval_status == null)
                && (!('approved_by' in request.resource.data) ||
                    request.resource.data.approved_by == null)
                && (!('approved_at' in request.resource.data) ||
                    request.resource.data.approved_at == null)
                && (!('rejection_reason' in request.resource.data) ||
                    request.resource.data.rejection_reason == null))
            // UPDATE: approval fields must not be in the diff.
            || (resource != null
                && !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['approval_status', 'approved_by',
                             'approved_at', 'rejection_reason']))
          )
        ) : isRoleUser(appId);  // DEFAULT: any recognised role; closes anonymous write

      // Deletes: finance collections admin-only; everything else admin/manager.
      allow delete: if (
        collection in ['audit_logs', 'inventory_movements']
      ) ? false
        : (
        collection in ['journal_entries', 'reconcile_matches',
                       'recurring_rules', 'fiscal_year_closings',
                       'opening_balances', 'chart_of_accounts']
      ) ? isAdmin(appId)
        : (collection in ['reconcile_sessions', 'journal_drafts', 'journal_templates']) ? isFinanceWriter(appId)
        : isFinanceWriter(appId);
    }

    // ── Audit logs ────────────────────────────────────────────────────────────
    // Append-only: any role-bearing user may create; nobody may edit or delete.
    // Read restricted to admin and accountant (matches the permissions model).
    match /artifacts/{appId}/public/data/audit_logs/{docId} {
      allow read: if hasAnyRole(appId, ['admin', 'accountant']);
      allow create: if isRoleUser(appId);
      allow update, delete: if false;
    }

    // ── Inventory movements ───────────────────────────────────────────────────
    // Append-only mirror of challan saves.  Any role-bearing user may append;
    // nobody may edit or delete to preserve the truthful trail.
    match /artifacts/{appId}/public/data/inventory_movements/{docId} {
      allow read: if isAuthed();
      allow create: if isRoleUser(appId);
      allow update, delete: if false;
    }

    // ── Expenses ──────────────────────────────────────────────────────────────
    // All role-bearing users may submit their own expenses (create).
    // Edit/approval restricted to admin, accountant, manager; or the owner of
    // the record for minor self-corrections.
    // Delete restricted to admin and accountant only.
    match /artifacts/{appId}/public/data/expenses/{docId} {
      allow read: if isAuthed();
      allow create: if isRoleUser(appId);
      allow update: if hasAnyRole(appId, ['admin', 'accountant', 'manager'])
                    || (isRoleUser(appId)
                        && resource.data.employee_id == userEmpId()
                        && resource.data.status == 'Pending');
      allow delete: if hasAnyRole(appId, ['admin', 'accountant']);
    }

    // ── Settings ──────────────────────────────────────────────────────────────
    // Read: isAuthed() is intentionally broad — the admin login flow reads
    // settings/security (admin password hash) before credentials are known.
    // Write: admin only.
    match /artifacts/{appId}/public/data/settings/{docId} {
      allow read: if isAuthed();
      allow write: if isAdmin(appId);
    }

    // ── Employees ─────────────────────────────────────────────────────────────
    // Read: isAuthed() is intentionally broad — login page reads this collection.
    // Create/delete: admin only.
    // Update: admin full access; any role-bearing user may update their own
    //         non-role fields (profile photo, contact details, etc.).
    match /artifacts/{appId}/public/data/employees/{empId} {
      allow read: if isAuthed();
      allow create, delete: if isAdmin(appId);
      allow update: if isAdmin(appId) ||
                    (isRoleUser(appId) && empId == userEmpId() &&
                     !('role' in request.resource.data.diff(resource.data).affectedKeys()));
    }

    // ── Users auth mirror ─────────────────────────────────────────────────────
    // Each authenticated Firebase Auth user owns a /users/{uid} doc that records
    // their role, used by userRole() for server-side rule evaluation.
    //
    // PRIVILEGE ESCALATION FIX: a user writing their own mirror may not set the
    // 'role' field to any value other than what their canonical /employees/{uid}
    // doc already holds.  This prevents a low-privilege user from self-promoting
    // by calling setDoc({ role: 'admin' }) directly on the SDK.
    //
    // Admin can manage all mirrors (needed for role changes that go through the
    // RBAC manager UI, which also updates the employee record first).
    match /artifacts/{appId}/public/data/users/{uid} {
      allow read: if isAuthed() && (uid == userEmpId() || isAdmin(appId));

      // Self-create: role field (if provided) must match the employee record.
      allow create: if isAuthed() && uid == userEmpId() && (
        !('role' in request.resource.data) ||
        request.resource.data.role ==
          get(/databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(userEmpId())).data.role
      );

      // Self-update: role may only be changed to the value in the employee record.
      allow update: if isAdmin(appId) || (
        isAuthed() && uid == userEmpId() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          request.resource.data.role ==
            get(/databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(userEmpId())).data.role
        )
      );

      allow delete: if isAdmin(appId);
    }
  }
}

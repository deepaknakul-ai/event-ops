rules_version = '2';

// Rental-Ops Firestore rules (Phase 6 — Security Hardening).
// Deploy with:  firebase deploy --only firestore:rules
//
// Security model:
//   - All app data lives under /artifacts/{appId}/public/data/{collection}/{doc}
//   - Reads are open to any authenticated session (anonymous sessions are used
//     by the login page to read employees/settings before credentials are
//     verified — a known design constraint).
//   - Writes ALWAYS require a recognised role (admin/accountant/manager/tech/user).
//     Anonymous sessions cannot write anything.
//   - Finance-sensitive collections additionally require admin or manager.
//   - Append-only collections (audit_logs, inventory_movements) are explicitly
//     excluded from the broad wildcard update path so the specific "if false"
//     guards below cannot be bypassed via OR semantics.
//   - The /users/{uid} role mirror is constrained: self-writes may not set the
//     role field to any value other than what the canonical /employees/{uid}
//     doc already holds, closing the privilege-escalation path.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    function userEmpId() {
      return request.auth.uid;
    }

    // Role lookup: /users/{uid} mirror first (written on login upgrade),
    // falls back to /employees/{uid} for the migration window.
    function userRole(appId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(userEmpId()))
        ? get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(userEmpId())).data.role
        : get(/databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(userEmpId())).data.role;
    }

    function hasRole(appId, role) {
      return isAuthed() && userRole(appId) == role;
    }

    function hasAnyRole(appId, roles) {
      return isAuthed() && (userRole(appId) in roles);
    }

    // isRoleUser: authenticated AND holds any recognised role.
    // Prevents anonymous sessions from writing (closes the broad isAuthed() gap).
    function isRoleUser(appId) {
      return hasAnyRole(appId, ['admin', 'accountant', 'manager', 'tech', 'user']);
    }

    function isFinanceWriter(appId) {
      return hasAnyRole(appId, ['admin', 'manager']);
    }

    function isAdmin(appId) {
      return hasRole(appId, 'admin');
    }

    // Admin + Accountant get full (unscoped) visibility of clients/projects.
    function isAccountant(appId) {
      return hasRole(appId, 'accountant');
    }
    function seesAllParties(appId) {
      return isAdmin(appId) || isAccountant(appId);
    }

    // ── Default deny for anything outside /artifacts ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // App registry doc consumed by Cloud Functions cron.
    match /meta/active_apps {
      allow read: if false;
      allow create, update: if isAuthed();
      allow delete: if false;
    }

    // ── Broad catch-all for app-scoped data ───────────────────────────────────
    // NOTE: Firestore grants access if ANY matching rule permits it (OR logic).
    // Append-only collections MUST be excluded here; their specific "if false"
    // guards below would otherwise be bypassed by this wildcard's update path.
    match /artifacts/{appId}/public/data/{collection}/{docId} {

      // Reads: real (non-anonymous) authenticated sessions only.
      // audit_logs is explicitly excluded: its specific rule below restricts
      // reads to admin/accountant only (Firestore OR semantics would let
      // this wildcard override that restriction without the exclusion).
      // employees and settings are also excluded — their specific rules below
      // apply stricter checks (employees: non-anonymous; settings/security: admin).
      allow read: if isAuthed()
                  && request.auth.token.firebase.sign_in_provider != 'anonymous'
                  && collection != 'audit_logs'
                  && collection != 'employees'
                  && collection != 'settings'
                  // chat_* are excluded here so the stricter chat rules below are
                  // authoritative (OR-semantics would otherwise expose private DMs).
                  // clients is excluded so the owner-scoped client rules below are
                  // authoritative (managers see only their own clients/vendors).
                  && !(collection in ['chat_channels', 'chat_reads', 'chat_presence', 'chat_push_tokens',
                                      'employee_locations', 'location_history',
                                      'clients']);

      // Writes: require a recognised role (not anonymous).
      // Finance collections: admin/manager only, with extra journal_drafts guard.
      // Append-only (audit_logs, inventory_movements): blocked here; handled below.
      // Everything else: any role-bearing user (admin/manager/tech/accountant/user).
      allow create, update: if (
        collection in ['audit_logs', 'inventory_movements', 'chat_channels', 'chat_reads', 'chat_presence', 'chat_push_tokens', 'employee_locations', 'location_history', 'clients']
      ) ? false
        : (
        collection in ['recurring_rules', 'reconcile_matches', 'reconcile_sessions',
                       'journal_entries', 'journal_drafts', 'journal_templates',
                       'chart_of_accounts',
                       'opening_balances', 'fiscal_year_closings',
                       'payments', 'payouts', 'vendor_payments',
                       'tax_invoices', 'purchase_invoices']
      ) ? (
          // Review-only metadata update on an AI journal entry — allow any finance
          // role (incl. accountant) to flag it reviewed without unlocking financials.
          (collection == 'journal_entries' && resource != null
            && hasAnyRole(appId, ['admin', 'accountant', 'manager'])
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['ai_reviewed', 'ai_reviewed_by', 'ai_reviewed_by_name', 'ai_reviewed_at']))
          || (isFinanceWriter(appId) && (
            collection != 'journal_drafts'
            || isAdmin(appId)
            // CREATE: managers may set approval_status to 'pending' only; no approver stamps.
            || (resource == null
                && (!('approval_status' in request.resource.data) ||
                    request.resource.data.approval_status == 'pending' ||
                    request.resource.data.approval_status == null)
                && (!('approved_by' in request.resource.data) ||
                    request.resource.data.approved_by == null)
                && (!('approved_at' in request.resource.data) ||
                    request.resource.data.approved_at == null)
                && (!('rejection_reason' in request.resource.data) ||
                    request.resource.data.rejection_reason == null))
            // UPDATE: approval fields must not be in the diff.
            || (resource != null
                && !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['approval_status', 'approved_by',
                             'approved_at', 'rejection_reason']))
          )
          // ── tax_invoices immutability guards ───────────────────────────────
          // These fields are locked once the invoice is created (resource != null = UPDATE).
          // invoice_no: immutable — changing a number post-issue breaks GSTR-1 continuity.
          // org_gstin_at_issue / supply_type / *_amount: immutable — changing these
          //   would silently corrupt the GST split already reported to the buyer.
          // invoice_date: admin-only change — needed for rare correction scenarios
          //   but too risky for manager-level edits (affects tax period allocation).
          && (collection != 'tax_invoices' || resource == null || (
            request.resource.data.invoice_no == resource.data.invoice_no
            && request.resource.data.get('org_gstin_at_issue', '') == resource.data.get('org_gstin_at_issue', '')
            && request.resource.data.get('supply_type', '') == resource.data.get('supply_type', '')
            && request.resource.data.get('cgst_amount', 0) == resource.data.get('cgst_amount', 0)
            && request.resource.data.get('sgst_amount', 0) == resource.data.get('sgst_amount', 0)
            && request.resource.data.get('igst_amount', 0) == resource.data.get('igst_amount', 0)
            && (request.resource.data.get('invoice_date', '') == resource.data.get('invoice_date', '')
                || isAdmin(appId))
            // status → 'Cancelled' is admin-only (Section 34 CGST Act workflow)
            && (request.resource.data.get('status', '') != 'Cancelled'
                || resource.data.get('status', '') == 'Cancelled'
                || isAdmin(appId))
          )))
        ) : isRoleUser(appId);  // DEFAULT: any recognised role; closes anonymous write

      // Deletes: finance collections admin-only; everything else admin/manager.
      allow delete: if (
        collection in ['audit_logs', 'inventory_movements', 'chat_channels', 'chat_reads', 'chat_presence', 'chat_push_tokens', 'employee_locations', 'location_history', 'clients']
      ) ? false
        : (
        collection in ['journal_entries', 'reconcile_matches',
                       'recurring_rules', 'fiscal_year_closings',
                       'opening_balances', 'chart_of_accounts']
      ) ? isAdmin(appId)
        : (collection in ['reconcile_sessions', 'journal_drafts', 'journal_templates']) ? isFinanceWriter(appId)
        : isFinanceWriter(appId);
    }

    // ── Audit logs ────────────────────────────────────────────────────────────
    // Append-only: any role-bearing user may create; nobody may edit or delete.
    // Read restricted to admin and accountant (matches the permissions model).
    match /artifacts/{appId}/public/data/audit_logs/{docId} {
      allow read: if hasAnyRole(appId, ['admin', 'accountant']);
      allow create: if isRoleUser(appId);
      allow update, delete: if false;
    }

    // ── Inventory movements ───────────────────────────────────────────────────
    // Append-only mirror of challan saves.  Any role-bearing user may append;
    // nobody may edit or delete to preserve the truthful trail.
    match /artifacts/{appId}/public/data/inventory_movements/{docId} {
      allow read: if isAuthed();
      allow create: if isRoleUser(appId);
      allow update, delete: if false;
    }

    // ── Expenses ──────────────────────────────────────────────────────────────
    // All role-bearing users may submit their own expenses (create).
    // Edit/approval restricted to admin, accountant, manager; or the owner of
    // the record for minor self-corrections.
    // Delete restricted to admin and accountant only.
    match /artifacts/{appId}/public/data/expenses/{docId} {
      allow read: if isAuthed();
      allow create: if isRoleUser(appId);
      allow update: if hasAnyRole(appId, ['admin', 'accountant', 'manager'])
                    || (isRoleUser(appId)
                        && resource.data.employee_id == userEmpId()
                        && resource.data.status == 'Pending');
      allow delete: if hasAnyRole(appId, ['admin', 'accountant']);
    }

    // ── Settings ──────────────────────────────────────────────────────────────
    // Secret-bearing settings docs (security, communication, payments, einvoice):
    //   admin-read only. Cloud Functions access them via Admin SDK (bypasses
    //   rules). All other settings docs: any real (non-anonymous) session.
    // Write: admin only.
    match /artifacts/{appId}/public/data/settings/{docId} {
      allow read: if (docId in ['security', 'communication', 'payments', 'einvoice'])
                    ? isAdmin(appId)
                    : (isAuthed() && request.auth.token.firebase.sign_in_provider != 'anonymous');
      allow write: if isAdmin(appId);
    }

    // ── Employees ─────────────────────────────────────────────────────────────
    // Read: real (non-anonymous) authenticated sessions only.
    //   The verifyLogin Cloud Function handles all login-time credential lookups
    //   server-side, so the login page no longer needs anonymous reads here.
    // Create/delete: admin only.
    // Update: admin full access; any role-bearing user may update their own
    //         non-role fields (profile photo, contact details, etc.).
    match /artifacts/{appId}/public/data/employees/{empId} {
      allow read: if isAuthed() && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create, delete: if isAdmin(appId);
      allow update: if isAdmin(appId) ||
                    (isRoleUser(appId) && empId == userEmpId() &&
                     !('role' in request.resource.data.diff(resource.data).affectedKeys()));
    }

    // ── Users auth mirror ─────────────────────────────────────────────────────
    // Each authenticated Firebase Auth user owns a /users/{uid} doc that records
    // their role, used by userRole() for server-side rule evaluation.
    //
    // PRIVILEGE ESCALATION FIX: a user writing their own mirror may not set the
    // 'role' field to any value other than what their canonical /employees/{uid}
    // doc already holds.  This prevents a low-privilege user from self-promoting
    // by calling setDoc({ role: 'admin' }) directly on the SDK.
    //
    // Admin can manage all mirrors (needed for role changes that go through the
    // RBAC manager UI, which also updates the employee record first).
    match /artifacts/{appId}/public/data/users/{uid} {
      allow read: if isAuthed() && (uid == userEmpId() || isAdmin(appId));

      // Self-create: role field (if provided) must match the employee record.
      // Supports two auth patterns:
      //   A) Auth UID == Firestore employee ID  (classic email-based login)
      //   B) Auth UID differs from employee ID  (synthetic-email login for employees
      //      without a real email — employee_id field carries the Firestore ID)
      function empRoleMatches(empId) {
        return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(empId)) &&
               request.resource.data.role ==
                 get(/databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(empId)).data.role;
      }
      allow create: if isAuthed() && uid == userEmpId() && (
        !('role' in request.resource.data) ||
        empRoleMatches(userEmpId()) ||
        ('employee_id' in request.resource.data && empRoleMatches(request.resource.data.employee_id))
      );

      // Self-update: role may only be changed to the value in the employee record.
      allow update: if isAdmin(appId) || (
        isAuthed() && uid == userEmpId() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          empRoleMatches(userEmpId()) ||
          ('employee_id' in request.resource.data && empRoleMatches(request.resource.data.employee_id))
        )
      );

      allow delete: if isAdmin(appId);
    }

    // ── Team chat ─────────────────────────────────────────────────────────────
    // chat_channels + their /messages subcollection, plus per-user chat_reads,
    // chat_presence and chat_push_tokens. These collections are EXCLUDED from the
    // broad wildcard above so the rules here are authoritative (Firestore
    // OR-semantics would otherwise let the wildcard's open read override DM
    // privacy). Open channels (team/announcement) are readable by any real user;
    // private channels (dm/project) only by a listed member or management.
    // Each message carries a denormalised channel_type + members so reads
    // authorise without a cross-document lookup.
    function chatCanRead(appId, ctype, members) {
      return isAuthed()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (ctype == 'team' || ctype == 'announcement'
            || (members is list && userEmpId() in members)
            || hasAnyRole(appId, ['admin', 'manager']));
    }

    match /artifacts/{appId}/public/data/chat_channels/{cid} {
      allow read: if chatCanRead(appId, resource.data.get('type', ''), resource.data.get('members', []));
      allow create, update: if isRoleUser(appId)
        && (request.resource.data.type == 'team'
            || request.resource.data.type == 'announcement'
            || (request.resource.data.members is list && userEmpId() in request.resource.data.members)
            || hasAnyRole(appId, ['admin', 'manager']));
      allow delete: if hasAnyRole(appId, ['admin', 'manager']);

      match /messages/{mid} {
        allow read: if chatCanRead(appId, resource.data.get('channel_type', ''), resource.data.get('members', []));
        // Sender must be the caller; announcements are management-only to post;
        // dm/project require membership; team is open to any role user.
        allow create: if isRoleUser(appId)
          && request.resource.data.sender_id == userEmpId()
          && (request.resource.data.channel_type == 'team'
              || (request.resource.data.channel_type == 'announcement' && hasAnyRole(appId, ['admin', 'manager']))
              || (request.resource.data.channel_type in ['dm', 'project']
                  && request.resource.data.members is list
                  && userEmpId() in request.resource.data.members));
        // Author may edit / soft-delete own message; management may moderate.
        allow update: if isRoleUser(appId)
          && (resource.data.sender_id == userEmpId() || hasAnyRole(appId, ['admin', 'manager']));
        allow delete: if hasAnyRole(appId, ['admin', 'manager']);
      }
    }

    // Per-user read cursors (unread counts + read receipts). Readable by any role
    // user (so "seen by" works); each person writes only their own cursor.
    match /artifacts/{appId}/public/data/chat_reads/{rid} {
      allow read: if isRoleUser(appId);
      allow create, update: if isRoleUser(appId) && request.resource.data.emp_id == userEmpId();
      allow delete: if false;
    }

    // Online presence. Readable by any role user; each person writes only their own.
    match /artifacts/{appId}/public/data/chat_presence/{empId} {
      allow read: if isRoleUser(appId);
      allow create, update, delete: if isRoleUser(appId) && empId == userEmpId();
    }

    // Push device tokens. Not client-readable (functions use the Admin SDK);
    // each user registers/removes only their own tokens.
    match /artifacts/{appId}/public/data/chat_push_tokens/{token} {
      allow read: if false;
      allow create, update: if isRoleUser(appId) && request.resource.data.emp_id == userEmpId();
      allow delete: if isRoleUser(appId) && (resource.data.emp_id == userEmpId() || isAdmin(appId));
    }

    // ── Employee location tracking ─────────────────────────────────────────────
    // Privacy: excluded from the open-read wildcard above. An employee writes only
    // their own location; reads are limited to themselves and management. History
    // is management-read only and append-only (pruned by a scheduled function via
    // the Admin SDK).
    match /artifacts/{appId}/public/data/employee_locations/{empId} {
      allow read: if isAuthed()
                  && request.auth.token.firebase.sign_in_provider != 'anonymous'
                  && (empId == userEmpId() || hasAnyRole(appId, ['admin', 'manager']));
      allow create, update: if isRoleUser(appId) && empId == userEmpId();
      allow delete: if hasAnyRole(appId, ['admin', 'manager']);
    }
    match /artifacts/{appId}/public/data/location_history/{docId} {
      allow read: if hasAnyRole(appId, ['admin', 'manager']);
      allow create: if isRoleUser(appId) && request.resource.data.emp_id == userEmpId();
      allow update: if false;
      allow delete: if hasAnyRole(appId, ['admin', 'manager']);
    }

    // ── Client / vendor ownership scoping ──────────────────────────────────────
    // Excluded from the generic wildcard above so these owner-scoped rules are
    // authoritative. Admin + Accountant see all; everyone else sees only clients
    // they own (owner_id == their employee id = auth.uid). A manager may create/
    // edit only clients they own and cannot reassign ownership; admin reassigns.
    // Only the MANAGER role is isolated (manager-vs-manager): a manager reads only
    // clients they own. Admin, accountant, user and tech keep full visibility
    // (zero behaviour change for them).
    match /artifacts/{appId}/public/data/clients/{cid} {
      allow read: if isAuthed()
                  && request.auth.token.firebase.sign_in_provider != 'anonymous'
                  && (!hasRole(appId, 'manager') || resource.data.get('owner_id', '') == userEmpId());
      allow create: if isAdmin(appId)
                    || (hasRole(appId, 'manager') && request.resource.data.get('owner_id', '') == userEmpId());
      allow update: if isAdmin(appId)
                    || (hasRole(appId, 'manager')
                        && resource.data.get('owner_id', '') == userEmpId()
                        && request.resource.data.get('owner_id', '') == userEmpId());
      allow delete: if isAdmin(appId);
    }
    // NOTE: project READS are intentionally NOT hard-scoped. Per the owner's
    // model a MANAGER sees OTHER projects OPERATIONALLY (shared calendar /
    // schedule / inventory-conflict view) with all financial fields stripped in
    // the UI (projectFinanceVisible in Projects.jsx et al. — a manager sees money
    // only on projects whose client they own). Financials are embedded in the
    // project document, so field-level hiding is enforced in the UI; a future
    // phase may split financial fields into a guarded subcollection for true
    // server-side enforcement. tech/user assigned-only scoping is likewise
    // deferred (risks dispatch/challan flows) pending a non-admin test login.
  }
}

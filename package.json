{
  "name": "rental-ops",
  "private": true,
  "version": "3.7.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:backup": "vite build --mode backup",
    "build:app": "vite build --base=./",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:saas": "vite build --mode saas",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:backup": "npm run build:backup && firebase deploy --project backup --only hosting",
    "deploy:backup:rules": "firebase deploy --project backup --only firestore:rules,storage",
    "deploy:saas": "npm run build:saas && firebase deploy --project saas --only hosting",
    "deploy:saas:rules": "firebase deploy --project saas --only firestore:rules,storage",
    "deploy:saas:functions": "firebase deploy --project saas --only functions",
    "verify:private-bundle": "npm run build && node scripts/check-private-bundle.cjs",
    "deploy:everywhere": "node scripts/deploy-everywhere.cjs",
    "release:patch": "npm version patch -m \"release: v%s\" && npm run build && firebase deploy --only hosting && git push --follow-tags",
    "release:minor": "npm version minor -m \"release: v%s\" && npm run build && firebase deploy --only hosting && git push --follow-tags",
    "release:major": "npm version major -m \"release: v%s\" && npm run build && firebase deploy --only hosting && git push --follow-tags"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "exceljs": "^4.4.0",
    "firebase": "^12.7.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.561.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.18.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.4",
    "vitest": "^4.1.6"
  }
}
